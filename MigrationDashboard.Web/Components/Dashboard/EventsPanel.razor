@using MigrationDashboard.Web.Models
@inject DashboardGridOptions GridOptions

<div class="events-panel">
    @if (Rows.Count == 0)
    {
        <div class="empty-state">
            <strong>No events found.</strong>
            <p>@(ShowAllEvents ? "Backend change events will appear here when available." : "No change events are linked to this form yet.")</p>
        </div>
    }
    else
    {
        <div class="table-shell events-table-shell" data-testid="events-scroll-region">
            <DxGrid Data="Rows"
                    CssClass="@GetGridCssClass()"
                    PageSize="@GetPageSize()"
                    PagerVisible="false"
                    ShowSearchBox="false"
                    FilterMenuButtonDisplayMode="@GetFilterMenuButtonDisplayMode()"
                    ColumnResizeMode="GridColumnResizeMode.NextColumn"
                    AllowSort="true">
                <Columns>
                    @if (ShowAllEvents)
                    {
                        <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.ProcessCode)" Caption="Process Code" Width="@GetProcessCodeColumnWidth()" VisibleIndex="0">
                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    var row = (EditableChangeEventRow)cellContext.DataItem;
                                }
                                <span class="grid-text-ellipsis" title="@row.ProcessCode">@row.ProcessCode</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.StepCode)" Caption="Step Code" Width="@GetStepCodeColumnWidth()" VisibleIndex="1">
                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    var row = (EditableChangeEventRow)cellContext.DataItem;
                                }
                                <span class="grid-text-ellipsis" title="@row.StepCode">@row.StepCode</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.FormName)" Caption="Form Name" Width="@GetFormNameColumnWidth()" VisibleIndex="2">
                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    var row = (EditableChangeEventRow)cellContext.DataItem;
                                }
                                <span class="grid-text-ellipsis" title="@row.FormName">@row.FormName</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    }
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.BuildNumber)" Caption="Build Number" Width="@GetBuildNumberColumnWidth()" VisibleIndex="@GetBuildNumberVisibleIndex()" />
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.BranchName)" Caption="Branch Name" Width="@GetBranchNameColumnWidth()" VisibleIndex="@GetBranchNameVisibleIndex()" />
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.ChangedBy)" Caption="Changed By" Width="@GetChangedByColumnWidth()" VisibleIndex="@GetChangedByVisibleIndex()" />
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.CommitId)" Caption="Commit Id" Width="@GetCommitIdColumnWidth()" VisibleIndex="@GetCommitIdVisibleIndex()">
                        <CellDisplayTemplate Context="cellContext">
                            @{
                                var row = (EditableChangeEventRow)cellContext.DataItem;
                            }
                            <span class="grid-text-ellipsis grid-text-ellipsis-commit" title="@row.CommitId">@row.CommitId</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.EventTimestamp)" Caption="Event Timestamp" Width="@GetEventTimestampColumnWidth()" DisplayFormat="yyyy-MM-dd HH:mm:ss" VisibleIndex="@GetEventTimestampVisibleIndex()" />
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.ObjectName)" Caption="Object Name" Width="@GetObjectNameColumnWidth()" VisibleIndex="@GetObjectNameVisibleIndex()">
                        <CellDisplayTemplate Context="cellContext">
                            @{
                                var row = (EditableChangeEventRow)cellContext.DataItem;
                            }
                            <strong class="grid-text-ellipsis" title="@row.ObjectName">@row.ObjectName</strong>
                            @if (!string.IsNullOrWhiteSpace(row.StatusMessage))
                            {
                                <div class="row-status @(row.HasError ? "error" : "success")">@row.StatusMessage</div>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.Layer)" Caption="Layer" Width="@GetLayerColumnWidth()" VisibleIndex="@GetLayerVisibleIndex()">
                        <CellDisplayTemplate Context="cellContext">
                            @{
                                var row = (EditableChangeEventRow)cellContext.DataItem;
                            }
                            <span class="grid-text-muted">@row.Layer</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.ObjectType)" Caption="Object Type" Width="@GetObjectTypeColumnWidth()" VisibleIndex="@GetObjectTypeVisibleIndex()" />
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.OwnershipCategory)" Caption="Ownership Category" Width="@GetOwnershipCategoryColumnWidth()" VisibleIndex="@GetOwnershipCategoryVisibleIndex()" />
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.ReviewStatus)" Caption="Review Status" Width="@GetReviewStatusColumnWidth()" VisibleIndex="@GetReviewStatusVisibleIndex()">
                        <CellDisplayTemplate Context="cellContext">
                            @{
                                var row = (EditableChangeEventRow)cellContext.DataItem;
                            }
                            @if (IsEditMode)
                            {
                                <select class="form-select form-select-sm grid-editor-control review-status-editor"
                                        data-editor="review-status"
                                        value="@row.ReviewStatus"
                                        @onchange="args => UpdateReviewStatusAsync(row, args.Value?.ToString())">
                                    @foreach (var status in ReviewStatuses.All)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            }
                            else
                            {
                                @row.ReviewStatus
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(EditableChangeEventRow.Remarks)" Caption="Remarks" VisibleIndex="@GetRemarksVisibleIndex()">
                        <CellDisplayTemplate Context="cellContext">
                            @{
                                var row = (EditableChangeEventRow)cellContext.DataItem;
                            }
                            @if (IsEditMode)
                            {
                                <textarea class="form-control form-control-sm grid-editor-control event-remarks-editor"
                                          rows="1"
                                          data-editor="event-remarks"
                                          @onchange="args => UpdateRemarksAsync(row, args.Value?.ToString())">@row.Remarks</textarea>
                            }
                            else
                            {
                                <span class="grid-text-ellipsis event-remarks-text" title="@GetRemarksTooltip(row.Remarks)">
                                    @GetRemarksDisplayValue(row.Remarks)
                                </span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGrid>
        </div>
    }
</div>

@code {
    [Parameter] public required IReadOnlyList<EditableChangeEventRow> Rows { get; set; }
    [Parameter] public bool ShowAllEvents { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public EventCallback<EditableChangeEventRow> RowChanged { get; set; }

    private GridFilterMenuButtonDisplayMode GetFilterMenuButtonDisplayMode()
    {
        return GridOptions.EnableColumnFiltering
            ? GridFilterMenuButtonDisplayMode.Never
            : GridFilterMenuButtonDisplayMode.Never;
    }

    private string GetGridCssClass()
    {
        return ShowAllEvents
            ? "dashboard-data-grid events-data-grid"
            : "dashboard-data-grid events-data-grid events-data-grid-compact";
    }

    private int GetPageSize()
    {
        return Math.Max(1, Rows.Count);
    }

    private string? GetProcessCodeColumnWidth() => ShowAllEvents ? "105px" : null;
    private string? GetStepCodeColumnWidth() => ShowAllEvents ? "95px" : null;
    private string? GetFormNameColumnWidth() => ShowAllEvents ? "160px" : null;
    private string? GetBuildNumberColumnWidth() => ShowAllEvents ? "60px" : null;
    private string? GetBranchNameColumnWidth() => ShowAllEvents ? "150px" : null;
    private string? GetChangedByColumnWidth() => ShowAllEvents ? "130px" : null;
    private string? GetCommitIdColumnWidth() => ShowAllEvents ? "115px" : "115px";
    private string? GetEventTimestampColumnWidth() => ShowAllEvents ? "150px" : null;
    private string? GetObjectNameColumnWidth() => ShowAllEvents ? "190px" : null;
    private string? GetLayerColumnWidth() => ShowAllEvents ? "90px" : "90px";
    private string? GetObjectTypeColumnWidth() => ShowAllEvents ? "105px" : "105px";
    private string? GetOwnershipCategoryColumnWidth() => ShowAllEvents ? "125px" : null;
    private string? GetReviewStatusColumnWidth() => ShowAllEvents ? "132px" : "132px";
    private int GetBuildNumberVisibleIndex() => ShowAllEvents ? 3 : 0;
    private int GetBranchNameVisibleIndex() => ShowAllEvents ? 4 : 1;
    private int GetChangedByVisibleIndex() => ShowAllEvents ? 5 : 2;
    private int GetCommitIdVisibleIndex() => ShowAllEvents ? 6 : 3;
    private int GetEventTimestampVisibleIndex() => ShowAllEvents ? 7 : 4;
    private int GetObjectNameVisibleIndex() => ShowAllEvents ? 8 : 5;
    private int GetLayerVisibleIndex() => ShowAllEvents ? 9 : 6;
    private int GetObjectTypeVisibleIndex() => ShowAllEvents ? 10 : 7;
    private int GetOwnershipCategoryVisibleIndex() => ShowAllEvents ? 11 : 8;
    private int GetReviewStatusVisibleIndex() => ShowAllEvents ? 12 : 9;
    private int GetRemarksVisibleIndex() => ShowAllEvents ? 13 : 10;

    private async Task UpdateReviewStatusAsync(EditableChangeEventRow row, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            row.ReviewStatus = value;
            await RowChanged.InvokeAsync(row);
        }
    }

    private async Task UpdateRemarksAsync(EditableChangeEventRow row, string? value)
    {
        row.Remarks = value;
        await RowChanged.InvokeAsync(row);
    }

    private static string GetRemarksDisplayValue(string? remarks)
    {
        return string.IsNullOrWhiteSpace(remarks) ? "-" : remarks;
    }

    private static string? GetRemarksTooltip(string? remarks)
    {
        return string.IsNullOrWhiteSpace(remarks) ? null : remarks;
    }
}
