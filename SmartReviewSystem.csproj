<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor" Version="25.1.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude generated/nested project artifacts from this client project build -->
    <Compile Remove="MigrationDashboard.Web\Program.cs" />
    <Compile Remove="MigrationDashboard.Web\Components\App.razor" />
    <Compile Remove="MigrationDashboard.Web\Components\Routes.razor" />
    <Compile Remove="SmartReviewSystem.Api\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <EmbeddedResource Remove="SmartReviewSystem.Api\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
    <EmbeddedResource Remove="artifacts\**\*" />
    <None Remove="SmartReviewSystem.Api\**\*" />
    <None Remove="tests\**\*" />
    <None Remove="artifacts\**\*" />
    <Content Remove="SmartReviewSystem.Api\**\*" />
    <Content Remove="tests\**\*" />
    <Content Remove="artifacts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\" />
  </ItemGroup>

</Project>
