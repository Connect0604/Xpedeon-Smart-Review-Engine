@page "/dashboard"

@using SmartReviewSystem.Services.DevOps
@using SmartReviewSystem.Models.DevOps
@using DevExpress.Blazor

<PageTitle>Orchestrator Dashboard</PageTitle>

<section class="dashboard-page">
    <header class="dashboard-hero">
        <div class="dashboard-hero__title">
            <div class="dashboard-hero__topline">
                <p class="dashboard-kicker">Orchestrator Dashboard</p>
            </div>
            <div class="dashboard-connection-pill dashboard-connection-pill--@ConnectionStatusCssClass">
                <span class="dashboard-connection-pill__dot"></span>
                <span>Azure DevOps</span>
                <strong>@ConnectionStatus</strong>
            </div>
        </div>

        <div class="dashboard-hero__actions">
            <div class="dashboard-reload-group">
                <button type="button"
                        class="dashboard-reload-button"
                        @onclick="LoadStoriesAsync"
                        disabled="@(!HasConnectionSettings || IsLoadingStories)">
                    @(IsLoadingStories ? "Reloading..." : "Reload")
                </button>
                @if (AutoReloadEnabled)
                {
                    <span class="dashboard-auto-reload-info" title="Dashboard automatically reloads at regular intervals">
                        Auto-reload: @FormatReloadInterval(ReloadIntervalSeconds)
                    </span>
                }
            </div>
        </div>
    </header>

    <section class="dashboard-panel">
        <div class="dashboard-panel__tabs">
            <div class="dashboard-tabs">
                <button type="button"
                        class="dashboard-tab @(ActiveTab == "running" ? "dashboard-tab--active" : string.Empty)"
                        @onclick="@(async () => SetActiveTab("running"))">
                    <span>Orchestrators Running</span>
                    <span class="dashboard-tab__count">@RunningStories.Count</span>
                </button>
                <button type="button"
                        class="dashboard-tab @(ActiveTab == "tracker" ? "dashboard-tab--active" : string.Empty)"
                        @onclick="@(async () => SetActiveTab("tracker"))">
                    <span>Story Tracker</span>
                    <span class="dashboard-tab__count">@Stories.Count</span>
                </button>
                <button type="button"
                        class="dashboard-tab @(ActiveTab == "bugs" ? "dashboard-tab--active" : string.Empty)"
                        @onclick="@(async () => SetActiveTab("bugs"))">
                    <span>Bug Tracker</span>
                    <span class="dashboard-tab__count">@TotalBugCount</span>
                </button>
            </div>
        </div>

        <div class="dashboard-tab-content">
            @if (ActiveTab == "running")
            {
                <div class="dashboard-tab-pane">
                    <div class="dashboard-toolbar">
                        <label class="dashboard-toolbar__search dashboard-filter-group">
                            <span class="dashboard-filter-label">Search</span>
                            <input class="dashboard-filter-input" @bind="RunningSearchText" @bind:event="oninput" placeholder="Story ID, title, assignee, MFE, execution mode, phase" />
                        </label>
                        <label class="dashboard-filter-group">
                            <span class="dashboard-filter-label">Filter</span>
                            <select class="dashboard-filter-select" @onchange="HandleOrchestratorFilterChanged">
                                <option value="Coding In Progress" selected="@(OrchestratorFilter == "Coding In Progress")">Coding In Progress</option>
                                <option value="All" selected="@(OrchestratorFilter == "All")">All</option>
                            </select>
                        </label>
                    </div>

                    <div class="dashboard-section-toggle-row">
                        <span class="dashboard-section-toggle-label">Running User Stories</span>
                        <button type="button"
                                class="section-toggle section-toggle-icon"
                                data-testid="running-stories-section-toggle"
                                aria-expanded="@(_isRunningStoriesExpanded ? "true" : "false")"
                                @onclick="ToggleRunningStoriesSection">
                            <span class="section-chevron" aria-hidden="true">@(_isRunningStoriesExpanded ? "-" : "+")</span>
                        </button>
                    </div>

                    @if (_isRunningStoriesExpanded)
                    {
                        @if (RunningStories.Count == 0)
                        {
                            <div class="dashboard-empty dashboard-empty--compact">
                                <p>No stories are currently running in the orchestrator.</p>
                            </div>
                        }
                        else
                        {
                            <div class="dashboard-table-wrap dashboard-table-wrap--running">
                                <DxGrid Data="RunningStories"
                                        ShowAllRows="true"
                                        KeyFieldName="Id"
                                        CssClass="dashboard-dxgrid dashboard-dxgrid--running"
                                        AllowSort="true"
                                        PagerVisible="false"
                                        ShowSearchBox="false"
                                        DetailRowDisplayMode="GridDetailRowDisplayMode.Auto"
                                        DetailExpandButtonDisplayMode="GridDetailExpandButtonDisplayMode.Auto"
                                        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always">
                                    <Columns>
                                        <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.Id)" Caption="ID" Width="100">
                                            <CellDisplayTemplate Context="cellContext">
                                                @{
                                                    var story = (DevOpsStoryItem)cellContext.DataItem;
                                                    <div style="text-align: left;">
                                                        <a href="@story.WorkItemUrl" target="_blank" rel="noopener noreferrer" title="Open in Azure DevOps" class="story-id-badge">@story.Id</a>
                                                    </div>
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.Title)" Caption="Title" MinWidth="220" />
                                        <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.Mfe)" Caption="MFE" MinWidth="110">
                                            <CellDisplayTemplate Context="cellContext">
                                                @{
                                                    var story = (DevOpsStoryItem)cellContext.DataItem;
                                                    @DisplayOrDash(story.Mfe)
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.AssignedTo)" Caption="Assigned To" MinWidth="150">
                                            <CellDisplayTemplate Context="cellContext">
                                                @{
                                                    var story = (DevOpsStoryItem)cellContext.DataItem;
                                                    @DisplayOrDash(story.AssignedTo)
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.ExecutionMode)" Caption="Execution Mode" MinWidth="130">
                                            <CellDisplayTemplate Context="cellContext">
                                                @{
                                                    var story = (DevOpsStoryItem)cellContext.DataItem;
                                                    @DisplayOrDash(story.ExecutionMode)
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.OrchestratorPhase)" Caption="Orchestrator Phase" MinWidth="100">
                                            <CellDisplayTemplate Context="cellContext">
                                                @{
                                                    var story = (DevOpsStoryItem)cellContext.DataItem;
                                                    @DisplayOrDash(story.OrchestratorPhase)
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.BranchName)" Caption="Branch Name" MinWidth="180">
                                            <CellDisplayTemplate Context="cellContext">
                                                @{
                                                    var story = (DevOpsStoryItem)cellContext.DataItem;
                                                    @DisplayOrDash(story.BranchName)
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.OrchestratorPhase)" Caption="Progress" MinWidth="300" AllowSort="false">
                                            <CellDisplayTemplate Context="cellContext">
                                                @{
                                                    var story = (DevOpsStoryItem)cellContext.DataItem;
                                                    var progress = GetProgressPercentage(story.OrchestratorPhase);
                                                    var phaseStageInfo = GetPhaseStageInfo(story.OrchestratorPhase);
                                                    var progressBarCssClass = GetProgressBarCssClass(story.OrchestratorPhase);
                                                    <div class="orchestrator-progress-container">
                                                        <div class="orchestrator-progress-bar-wrapper @progressBarCssClass">
                                                            <div class="orchestrator-progress-bar" style="width: @progress%">
                                                                <div class="orchestrator-progress-bar-fill"></div>
                                                            </div>
                                                            <div class="orchestrator-progress-bar-bg"></div>
                                                        </div>
                                                        <div class="orchestrator-progress-info">
                                                            <span class="orchestrator-progress-percentage">@progress%</span>
                                                            @if (phaseStageInfo != null)
                                                            {
                                                                <span class="orchestrator-progress-stage" title="@phaseStageInfo.StageName">@phaseStageInfo.StageName</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                    </Columns>
                                    <DetailRowTemplate Context="detailContext">
                                        @{
                                            var story = (DevOpsStoryItem)detailContext.DataItem;
                                            _ = LoadPhaseHistoryAsync(story);
                                            if (story.PhaseHistorySummary == null)
                                            {
                                                <div class="phase-history-container">
                                                    <div class="phase-history-loading">
                                                        <p>Loading phase history...</p>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="phase-history-container">
                                                    <div class="phase-history-summary">
                                                        <h4>Execution Summary</h4>
                                                        <div class="summary-grid">
                                                            <div class="summary-item">
                                                                <span class="summary-label">Started:</span>
                                                                <span class="summary-value">@ImplementationTimeHelper.FormatDateTimeOffset(story.PhaseHistorySummary.ExecutionStarted)</span>
                                                            </div>
                                                            <div class="summary-item">
                                                                <span class="summary-label">Last Activity:</span>
                                                                <span class="summary-value">@ImplementationTimeHelper.FormatDateTimeOffset(story.PhaseHistorySummary.ExecutionCompleted)</span>
                                                            </div>
                                                            <div class="summary-item">
                                                                <span class="summary-label">Total Duration:</span>
                                                                <span class="summary-value">@ImplementationTimeHelper.FormatDuration(story.PhaseHistorySummary.TotalDuration)</span>
                                                            </div>
                                                            <div class="summary-item">
                                                                <span class="summary-label">Current Status:</span>
                                                                <span class="summary-value">@(string.IsNullOrWhiteSpace(story.PhaseHistorySummary.FinalStatus) ? story.PhaseHistorySummary.CurrentRunningPhase : story.PhaseHistorySummary.FinalStatus)</span>
                                                            </div>
                                                            <div class="summary-item">
                                                                <span class="summary-label">Success Rate:</span>
                                                                <span class="summary-value">@GetSuccessRatePercentage(story.PhaseHistorySummary.SuccessRate)%</span>
                                                            </div>
                                                        </div>

                                                        <div class="summary-metrics">
                                                            <div class="metric">
                                                                <span class="metric-label">Total Phases:</span>
                                                                <span class="metric-value">@story.PhaseHistorySummary.TotalPhases</span>
                                                            </div>
                                                            <div class="metric">
                                                                <span class="metric-label">Completed:</span>
                                                                <span class="metric-value">@story.PhaseHistorySummary.CompletedPhases</span>
                                                            </div>
                                                            <div class="metric">
                                                                <span class="metric-label">Errored:</span>
                                                                <span class="metric-value">@story.PhaseHistorySummary.ErroredPhases</span>
                                                            </div>
                                                            <div class="metric">
                                                                <span class="metric-label">Recovered:</span>
                                                                <span class="metric-value">@story.PhaseHistorySummary.RecoveredErrors</span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @if (story.PhaseHistorySummary.PhaseHistory.Count > 0)
                                                    {
                                                        <div class="phase-history-table">
                                                            <table class="phases-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Phase Name</th>
                                                                        <th>Start Time</th>
                                                                        <th>Duration</th>
                                                                        <th>Status</th>
                                                                        <th>Error</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var phase in story.PhaseHistorySummary.PhaseHistory)
                                                                    {
                                                                        <tr class="@GetPhaseStatusCssClass(phase.FinalStatus)">
                                                                            <td>@phase.PhaseName</td>
                                                                            <td>@ImplementationTimeHelper.FormatDateTimeOffset(phase.StartTime)</td>
                                                                            <td>@ImplementationTimeHelper.FormatDuration(phase.Duration)</td>
                                                                            <td>
                                                                                @FormatPhaseStatus(phase.FinalStatus)
                                                                            </td>
                                                                            <td>
                                                                                @if (phase.HasError)
                                                                                {
                                                                                    <span class="error-marker" title="@StripHtmlTags(phase.ErrorMessage)">? Error at @ImplementationTimeHelper.FormatDateTimeOffset(phase.ErrorTime)</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span>-</span>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </DetailRowTemplate>
                                </DxGrid>
                            </div>
                        }
                    }

                    @if (OrchestratorFilter == "Coding In Progress")
                    {
                        <div class="dashboard-section-toggle-row dashboard-section-toggle-row--mfe">
                            <span class="dashboard-section-toggle-label">MFE List</span>
                            <button type="button"
                                    class="section-toggle section-toggle-icon"
                                    data-testid="mfe-fields-section-toggle"
                                    aria-expanded="@(_isMfeFieldsExpanded ? "true" : "false")"
                                    @onclick="ToggleMfeFieldsSection">
                                <span class="section-chevron" aria-hidden="true">@(_isMfeFieldsExpanded ? "-" : "+")</span>
                            </button>
                        </div>

                        @if (_isMfeFieldsExpanded)
                        {
                            @if (IsLoadingMfeModules)
                            {
                                <div class="dashboard-mfe-modules-section">
                                    <div class="mfe-modules-loading">
                                        <p>Loading MFE modules...</p>
                                    </div>
                                </div>
                            }
                            else if (MfeModules.Count > 0)
                            {
                                <div class="dashboard-mfe-modules-section">
                                    <div class="mfe-modules-grid-wrap">
                                        <DxGrid Data="MfeModules"
                                                ShowAllRows="true"
                                                KeyFieldName="ModuleName"
                                                CssClass="dashboard-dxgrid dashboard-dxgrid--mfe-modules"
                                                AllowSort="true"
                                                PagerVisible="false"
                                                ShowSearchBox="false">
                                            <Columns>
                                                <DxGridDataColumn FieldName="@nameof(MfeModuleItem.ModuleName)" Caption="Module Name" MinWidth="300">
                                                    <CellDisplayTemplate Context="cellContext">
                                                        @{
                                                            var module = (MfeModuleItem)cellContext.DataItem;
                                                            <span class="mfe-module-name">
                                                                <span class="mfe-module-status-dot @(module.IsAvailable ? "mfe-module-status-dot--available" : "mfe-module-status-dot--unavailable")"></span>
                                                                <span>@module.ModuleName</span>
                                                            </span>
                                                        }
                                                    </CellDisplayTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="@nameof(MfeModuleItem.StoriesCount)" Caption="Stories In Progress" MinWidth="150" AllowSort="true">
                                                    <CellDisplayTemplate Context="cellContext">
                                                        @{
                                                            var module = (MfeModuleItem)cellContext.DataItem;
                                                            <span class="mfe-stories-badge">@module.StoriesCount</span>
                                                        }
                                                    </CellDisplayTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="@nameof(MfeModuleItem.ActivePrCount)" Caption="Active PRs" MinWidth="120" AllowSort="true">
                                                    <CellDisplayTemplate Context="cellContext">
                                                        @{
                                                            var module = (MfeModuleItem)cellContext.DataItem;
                                                            <span class="active-pr-badge @(module.ActivePrCount > 0 ? "active-pr-badge--yes" : "active-pr-badge--no")">@module.ActivePrCount</span>
                                                        }
                                                    </CellDisplayTemplate>
                                                </DxGridDataColumn>
                                            </Columns>
                                        </DxGrid>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="dashboard-mfe-modules-section">
                                    <div class="mfe-modules-empty">
                                        <p>No MFE modules configured or failed to load.</p>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            }
            else if (ActiveTab == "tracker")
            {
                <div class="dashboard-tab-pane">
                    <div class="dashboard-toolbar">
                        <label class="dashboard-toolbar__search dashboard-filter-group">
                            <span class="dashboard-filter-label">Search</span>
                            <input class="dashboard-filter-input" @bind="SearchText" @bind:event="oninput" placeholder="Story ID, title, assignee, MFE, execution mode, phase" />
                        </label>
                        <label class="dashboard-filter-group">
                            <span class="dashboard-filter-label">State</span>
                            <select class="dashboard-filter-select" @bind="StateFilter">
                                <option value="Any">Any</option>
                                <option value="New">New</option>
                                <option value="Active">Active</option>
                                <option value="Coding In Progress">Coding In Progress</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Closed">Closed</option>
                                <option value="Testing Requested">Testing Requested</option>
                            </select>
                        </label>
                        <div class="dashboard-toolbar__meta">
                            <span>Stories: <strong>@Stories.Count</strong></span>
                            <span>Visible: <strong>@FilteredStories.Count</strong></span>
                        </div>
                        @if (!AllImplementationDetailsLoaded && Stories.Count > 0)
                        {
                            <button type="button"
                                    class="dashboard-load-all-details-btn"
                                    @onclick="LoadAllImplementationDetailsAsync"
                                    disabled="@IsLoadingAllImplementationDetails">
                                @(IsLoadingAllImplementationDetails ? "Loading Implementation Details..." : "Load Implementation Details")
                            </button>
                        }
                    </div>

                    @if (FilteredStories.Count == 0)
                    {
                        <div class="dashboard-empty">
                            @if (IsLoadingStories)
                            {
                                <p>Loading stories from Azure DevOps...</p>
                            }
                            else if (!HasConnectionSettings)
                            {
                                <p>Azure DevOps configuration is unavailable.</p>
                            }
                            else
                            {
                                <p>No stories match the current dashboard query or filters.</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-table-wrap dashboard-table-wrap--tracker">
                            <DxGrid Data="FilteredStories"
                                    ShowAllRows="true"
                                    KeyFieldName="Id"
                                    CssClass="dashboard-dxgrid"
                                    AllowSort="true"
                                    PagerVisible="false"
                                    ShowSearchBox="false"
                                    FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.Id)" Caption="ID" Width="80">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                <div style="text-align: left;">
                                                    <a href="@story.WorkItemUrl" target="_blank" rel="noopener noreferrer" title="Open in Azure DevOps" class="story-id-badge">@story.Id</a>
                                                </div>
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.Title)" Caption="Title" MinWidth="200" />
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.AssignedTo)" Caption="Assigned To" MinWidth="120">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                @DisplayOrDash(story.AssignedTo)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.State)" Caption="State" MinWidth="120">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                @DisplayOrDash(story.State)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.BugCount)" Caption="Bug Count" MinWidth="100" />
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.Mfe)" Caption="MFE" MinWidth="100">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                @DisplayOrDash(story.Mfe)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.ExecutionMode)" Caption="Execution Mode" MinWidth="130">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                @DisplayOrDash(story.ExecutionMode)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.OrchestratorPhase)" Caption="Orchestrator Phase" MinWidth="140">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                @DisplayOrDash(story.OrchestratorPhase)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.ImplementationStartedAt)" Caption="Start Date" MinWidth="140">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                @FormatDateTimeOrDash(story.ImplementationStartedAt)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.ImplementationEndedAt)" Caption="End Date" MinWidth="140">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                @FormatDateTimeOrDash(story.ImplementationEndedAt)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.ImplementationDuration)" Caption="ToTal Time" MinWidth="100">
                                        <HeaderCaptionTemplate>
                                            <span title="Total time is calculated from Plan Approved to Implementation Complete.">ToTal Time</span>
                                        </HeaderCaptionTemplate>
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                var implTime = FormatImplementationTime(story.ImplementationDuration);
                                                <span title="@FormatImplementationTimeTooltip(story.StartDate, story.CompletionDate)">@implTime</span>
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(DevOpsStoryItem.ImplementationCost)" Caption="Cost" MinWidth="100">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var story = (DevOpsStoryItem)cellContext.DataItem;
                                                @FormatImplementationCost(story.ImplementationCost)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                </Columns>
                            </DxGrid>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(LoadError))
                    {
                        <p class="dashboard-error">@LoadError</p>
                    }
                </div>
            }
            else if (ActiveTab == "bugs")
            {
                <div class="dashboard-tab-pane">
                    <div class="dashboard-toolbar dashboard-toolbar--bugs">
                        <label class="dashboard-toolbar__search dashboard-filter-group dashboard-filter-group--bug-search">
                            <span class="dashboard-filter-label">Search</span>
                            <input class="dashboard-filter-input"
                                   @bind="BugSearchText"
                                   @bind:event="oninput"
                                   placeholder="Search story ID, story title, bug ID, bug title, assignee, state" />
                        </label>
                        <button type="button"
                                class="dashboard-group-toggle-btn"
                                @onclick="CollapseAllBugGroups">
                            Collapse All
                        </button>
                        <button type="button"
                                class="dashboard-group-toggle-btn"
                                @onclick="ExpandAllBugGroups">
                            Expand All
                        </button>
                        
                        <div class="dashboard-toolbar__meta">
                            <span>Stories With Bugs: <strong>@BugGroups.Count</strong></span>
                            <span>Total Bugs: <strong>@TotalBugCount</strong></span>
                        </div>
                    </div>

                    @if (IsLoadingStories)
                    {
                        <div class="dashboard-empty">
                            <p>Loading bugs from Azure DevOps...</p>
                        </div>
                    }
                    else if (!HasConnectionSettings)
                    {
                        <div class="dashboard-empty">
                            <p>Azure DevOps configuration is unavailable.</p>
                        </div>
                    }
                    else if (BugGroups.Count == 0)
                    {
                        <div class="dashboard-empty">
                            <p>No bugs found for the current user stories.</p>
                        </div>
                    }
                    else if (FilteredBugTrackerRows.Count == 0)
                    {
                        <div class="dashboard-empty">
                            <p>No bugs match the current bug tracker search.</p>
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-table-wrap dashboard-table-wrap--bugs" @key="_bugGridRenderVersion">
                            <DxGrid Data="FilteredBugTrackerRows"
                                    ShowAllRows="true"
                                    KeyFieldName="@nameof(BugTrackerRow.BugId)"
                                    CssClass="dashboard-dxgrid dashboard-dxgrid--bugs"
                                    AllowSort="true"
                                    PagerVisible="false"
                                    ShowSearchBox="false"
                                    AutoExpandAllGroupRows="@_autoExpandAllBugGroups"
                                    FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(BugTrackerRow.StoryGroupKey)"
                                                      Caption="Story"
                                                      GroupIndex="0"
                                                      Visible="false">
                                        <GroupRowTemplate Context="groupContext">
                                            @{
                                                var storyGroup = ParseStoryGroupKey(groupContext.GroupValue);
                                            }
                                            <div class="bug-story-group">
                                                <a href="@FilteredBugTrackerRows.FirstOrDefault(row => row.StoryId.ToString() == storyGroup.StoryId)?.StoryWorkItemUrl"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="bug-story-group__id">
                                                        @storyGroup.StoryId
                                                </a>
                                                <span class="bug-story-group__title">@storyGroup.StoryTitle</span>
                                            </div>
                                        </GroupRowTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(BugTrackerRow.BugId)" Caption="ID" Width="80">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var row = (BugTrackerRow)cellContext.DataItem;
                                                <a href="@row.BugWorkItemUrl" target="_blank" rel="noopener noreferrer" class="story-id-badge">@row.BugId</a>
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(BugTrackerRow.BugTitle)" Caption="Bug Title" MinWidth="800" />
                                    <DxGridDataColumn FieldName="@nameof(BugTrackerRow.AssignedTo)" Caption="Assigned To" MinWidth="120">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var row = (BugTrackerRow)cellContext.DataItem;
                                                @DisplayOrDash(row.AssignedTo)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="@nameof(BugTrackerRow.State)" Caption="State" MinWidth="120">
                                        <CellDisplayTemplate Context="cellContext">
                                            @{
                                                var row = (BugTrackerRow)cellContext.DataItem;
                                                @DisplayOrDash(row.State)
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                </Columns>
                            </DxGrid>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</section>
