@page "/"

<PageTitle>Smart Review System</PageTitle>

@if (!HasFileLoaded)
{
    <div class="srs-upload-screen">
        <div class="srs-workspace-header">
            <div class="srs-workspace-row">
                <div class="srs-source-switch" role="group" aria-label="Upload source">
                    <button type="button" class="@(CurrentUploadSource == UploadSource.AzureDevOps ? "active" : string.Empty)" @onclick="() => SetUploadSource(UploadSource.AzureDevOps)">Azure DevOps</button>
                    <button type="button" class="@(CurrentUploadSource == UploadSource.Local ? "active" : string.Empty)" @onclick="() => SetUploadSource(UploadSource.Local)">Local upload</button>
                </div>
                <div class="srs-context-pill">@ActiveContextLabel</div>
            </div>
        </div>

        @if (CurrentUploadSource == UploadSource.Local)
        {
            <div class="srs-dropzone @(IsDragging ? "dragging" : string.Empty)"
                 @ondragenter="OnDragEnter"
                 @ondragover="OnDragOver"
                 @ondragleave="OnDragLeave"
                 @ondrop="OnDrop"
                 @ondragenter:preventDefault="true"
                 @ondragover:preventDefault="true"
                 @ondragleave:preventDefault="true"
                 @ondrop:preventDefault="true">
                <InputFile OnChange="HandleFileSelected" accept=".md,.txt,.markdown" class="srs-file-input" />
                <div class="srs-upload-icon">UP</div>
                <h2>Drop your .md plan file here</h2>
                <p>or click to browse</p>
                <p class="srs-upload-hint">Accepted: <code>.md</code>, <code>.txt</code>, <code>.markdown</code></p>
            </div>
        }
        else
        {
            <div class="srs-devops-panel">
                <div class="srs-panel-header">
                    <h2>Azure DevOps Story Explorer</h2>
                    <button type="button" class="srs-btn srs-btn-ghost" @onclick="() => IsDevOpsFiltersCollapsed = !IsDevOpsFiltersCollapsed">
                        @(IsDevOpsFiltersCollapsed ? "Show filters" : "Hide filters")
                    </button>
                </div>
                @if (!IsDevOpsFiltersCollapsed)
                {
                    <div class="srs-devops-grid">
                        <input class="srs-section-search" placeholder="Organization (e.g. your-org)" @bind="DevOpsOrganization" />
                        <input class="srs-section-search" placeholder="Project" @bind="DevOpsProject" />
                        <input class="srs-section-search" placeholder="PAT token (session only)" @bind="DevOpsPatToken" type="password" />
                    </div>
                    <div class="srs-guided-filters">
                        <input class="srs-section-search" placeholder="Tag contains (e.g. Master AI Development)" @bind="DevOpsTagFilter" />
                        <select class="srs-section-search" @bind="DevOpsStateFilter">
                            <option value="Any">Any state</option>
                            <option value="New">New</option>
                            <option value="Active">Active</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                            <option value="Testing Requested">Testing Requested</option>
                        </select>
                        <input class="srs-section-search" placeholder="Assigned to contains" @bind="DevOpsAssignedFilter" />
                    </div>
                    <div class="srs-devops-row">
                        <label class="srs-toggle">
                            <input type="checkbox" @bind="UseAdvancedWiql" />
                            <span>Use advanced WIQL</span>
                        </label>
                        <label class="srs-toggle">
                            <input type="checkbox" @bind="DevOpsOnlyWithAttachments" />
                            <span>Only stories with attachments</span>
                        </label>
                        <span class="srs-connection @($"status-{DevOpsConnectionStatus.ToLowerInvariant()}")">Connection: @DevOpsConnectionStatus</span>
                    </div>
                    @if (UseAdvancedWiql)
                    {
                        <textarea class="srs-devops-condition" @bind="DevOpsCondition"></textarea>
                    }
                }
                <button type="button" class="srs-btn srs-btn-primary srs-load-btn" @onclick="LoadStoriesFromDevOpsAsync" disabled="@IsLoadingStories">
                    @(IsLoadingStories ? "Loading..." : "Load user stories")
                </button>
                <div class="srs-devops-row" style="margin-top: 10px;">
                    <button type="button" class="srs-btn srs-btn-primary" @onclick="AnalyzeSelectedDevOpsAttachmentsAsync" disabled="@(SelectedAttachmentCount == 0 || IsLoadingStories)">
                        Analyze selected (@SelectedAttachmentCount)
                    </button>
                    <button type="button" class="srs-btn srs-btn-ghost" @onclick="ClearSelectedAttachments" disabled="@(SelectedAttachmentCount == 0)">
                        Clear selection
                    </button>
                </div>

                @if (DevOpsTotalStories > 0)
                {
                    <div class="srs-metric-grid">
                        <div class="srs-metric-card"><span>Stories</span><strong>@DevOpsTotalStories</strong></div>
                        <div class="srs-metric-card"><span>With Attachments</span><strong>@DevOpsStoriesWithAttachments</strong></div>
                        <div class="srs-metric-card"><span>Supported</span><strong>@DevOpsSupportedAttachmentCount</strong></div>
                        <div class="srs-metric-card"><span>Unsupported</span><strong>@DevOpsUnsupportedAttachmentCount</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(DevOpsUnsupportedExtensionSummary))
                    {
                        <details class="srs-devops-note-panel">
                            <summary>Why some files are not analyzable</summary>
                            <div class="srs-devops-note">Unsupported types: @DevOpsUnsupportedExtensionSummary</div>
                        </details>
                    }
                    @if (!string.IsNullOrWhiteSpace(DevOpsBuiltQuery))
                    {
                        <div class="srs-devops-note">Query used: <code>@DevOpsBuiltQuery</code></div>
                    }
                }

                @if (DevOpsStories.Count > 0)
                {
                    var filteredStories = FilteredDevOpsStories.ToList();
                    <input class="srs-section-search srs-devops-search" placeholder="Search in fetched stories (ID, title, assignee, tags)" @bind="DevOpsStorySearch" @bind:event="oninput" />
                    <div class="srs-story-list">
                        <table class="srs-devops-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Work Item Type</th>
                                    <th>Title</th>
                                    <th>Assigned To</th>
                                    <th>State</th>
                                    <th>Tags</th>
                                    <th>Orchestrator Phase</th>
                                    <th>Attached Files</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var story in filteredStories)
                                {
                                    <tr>
                                        <td>@story.Id</td>
                                        <td>@story.WorkItemType</td>
                                        <td>@story.Title</td>
                                        <td>@story.AssignedTo</td>
                                        <td>@story.State</td>
                                        <td>@(string.IsNullOrWhiteSpace(story.Tags) ? "-" : story.Tags)</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(story.OrchestratorPhase))
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                <span class="srs-orch-phase-badge">@story.OrchestratorPhase</span>
                                            }
                                        </td>
                                        <td>
                                            @if (story.Attachments.Count == 0)
                                            {
                                                <span>No attachment</span>
                                            }
                                            else
                                            {
                                                <div class="srs-attachment-list">
                                                    @foreach (var typeGroup in story.Attachments
                                                        .Where(a => a.IsSupported)
                                                        .OrderBy(a => a.Extension, StringComparer.OrdinalIgnoreCase)
                                                        .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
                                                        .GroupBy(a => a.Extension, StringComparer.OrdinalIgnoreCase))
                                                    {
                                                        <details class="srs-filetype-group" open>
                                                            <summary>type: @typeGroup.Key.ToLowerInvariant() (@typeGroup.Count())</summary>
                                                            @foreach (var attachment in typeGroup)
                                                            {
                                                                <div class="srs-attachment-row">
                                                                    <input
                                                                        type="checkbox"
                                                                        checked="@IsAttachmentSelected(story, attachment)"
                                                                        @onchange="(e) => ToggleAttachmentSelection(story, attachment, e.Value)"
                                                                        disabled="@(!attachment.IsSupported)" />
                                                                    <button type="button" class="srs-attachment-btn" @onclick="() => AnalyzeDevOpsAttachmentAsync(story, attachment)" disabled="@(!attachment.IsSupported)">
                                                                        <span>@attachment.Name</span>
                                                                        <span class="srs-attachment-meta">
                                                                            @attachment.DisplaySize | @attachment.AttachedBy | @attachment.DisplayAttachedOn
                                                                            @if (attachment.Name.EndsWith(".html", StringComparison.OrdinalIgnoreCase) || attachment.Name.EndsWith(".htm", StringComparison.OrdinalIgnoreCase))
                                                                            {
                                                                                <text> | open in browser</text>
                                                                            }
                                                                        </span>
                                                                    </button>
                                                                </div>
                                                            }
                                                        </details>
                                                    }
                                                    @if (story.Attachments.Any(a => !a.IsSupported))
                                                    {
                                                        <details class="srs-unsupported-wrap">
                                                            <summary>unsupported files (@story.Attachments.Count(a => !a.IsSupported))</summary>
                                                            @foreach (var typeGroup in story.Attachments
                                                                .Where(a => !a.IsSupported)
                                                                .OrderBy(a => a.Extension, StringComparer.OrdinalIgnoreCase)
                                                                .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
                                                                .GroupBy(a => a.Extension, StringComparer.OrdinalIgnoreCase))
                                                            {
                                                                <details class="srs-filetype-group" open>
                                                                    <summary>type: @typeGroup.Key.ToLowerInvariant() (@typeGroup.Count())</summary>
                                                                    @foreach (var attachment in typeGroup)
                                                                    {
                                                                        <button type="button" class="srs-attachment-btn" disabled="true">
                                                                            <span>@attachment.Name</span>
                                                                            <span class="srs-attachment-meta">@attachment.DisplaySize | @attachment.AttachedBy | @attachment.DisplayAttachedOn | unsupported</span>
                                                                        </button>
                                                                    }
                                                                </details>
                                                            }
                                                        </details>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(UploadError))
        {
            <p class="srs-error">@UploadError</p>
        }
        @if (!string.IsNullOrWhiteSpace(DevOpsError))
        {
            <p class="srs-error">@DevOpsError</p>
        }
    </div>
}
else
{
    var selectedSection = CurrentSection;
    var filteredSections = FilteredSections.ToList();

    <div class="srs-app">
        <header class="srs-topbar">
            <div class="srs-topbar-left">
                @if (ActiveStory is not null)
                {
                    <a class="srs-story-id-pill"
                       href="@($"https://dev.azure.com/{DevOpsOrganization}/{DevOpsProject}/_workitems/edit/{ActiveStory.Id}")"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Open user story in Azure DevOps">
                        #@ActiveStory.Id
                    </a>
                    <span class="srs-story-type-pill">@ActiveStory.WorkItemType</span>
                    <span class="srs-story-title">@ActiveStory.Title</span>
                    <span class="srs-topbar-divider"></span>
                }
                <span class="srs-file-pill">@UploadedFileName</span>
                <span class="srs-count-pill">@Sections.Count sections</span>
                <span class="srs-model-pill @(LastCallUsedFallback ? "srs-model-pill-fallback" : string.Empty)" title="Configured model chain">
                    Model: @ModelDisplay
                    @if (!string.IsNullOrWhiteSpace(LastUsedModel))
                    {
                        <text> | Active: @LastUsedModel</text>
                        @if (LastCallUsedFallback)
                        {
                            <text> | Fallback active (primary: @PrimaryModel)</text>
                        }
                    }
                </span>
            </div>
            <div class="srs-topbar-actions">
                @if (IsFullScanRunning)
                {
                    <span class="srs-fullscan-progress">
                        <span class="srs-ai-spinner srs-ai-spinner--sm"></span>
                        Scanning @FullScanProgress / @FullScanTotal…
                    </span>
                    <button type="button" class="srs-btn srs-btn-ghost" @onclick="() => { CancelActiveReview(); IsFullScanRunning = false; FullScanActiveSectionId = null; }">Cancel scan</button>
                }
                else
                {
                    @if (IsFullScanEnabled)
                    {
                        <button type="button" class="srs-btn srs-btn-scan" @onclick="RunFullScanAsync" disabled="@IsRunningAiReview">
                            @(_reviewCache.Count > 0 ? "Re-scan All" : "Scan All Sections")
                        </button>
                    }
                    @if (true)
                    {
                        @if (IsRunningAiReview)
                        {
                            <button type="button" class="srs-btn srs-btn-primary" disabled>
                                <span class="srs-ai-spinner srs-ai-spinner--sm"></span>
                                Running…
                            </button>
                        }
                        else if (SpokeResults.Count > 0)
                        {
                            <button type="button" class="srs-btn srs-btn-primary" @onclick="RunAiReviewAsync">Re-run AI Review</button>
                        }
                        else
                        {
                            <button type="button" class="srs-btn srs-btn-primary" @onclick="RunAiReviewAsync">Run AI Review</button>
                        }
                    }
                }
                <button type="button" class="srs-btn srs-btn-ghost" @onclick="ResetAll">Close</button>
            </div>
        </header>

        <div class="srs-review-shell">
            <aside class="srs-left-panel">
                <div class="srs-sidebar-head">
                    <div>
                        <div class="srs-panel-label">Sections</div>
                        <div class="srs-sidebar-summary">@Sections.Count total</div>
                    </div>
                </div>
                <div class="srs-search-wrap">
                    <input class="srs-section-search"
                           placeholder="Search sections"
                           @bind="SectionSearchText"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(SectionSearchText))
                    {
                        <button type="button"
                                class="srs-search-clear"
                                @onclick="() => SectionSearchText = string.Empty"
                                aria-label="Clear search">
                            &times;
                        </button>
                    }
                </div>
                <div class="srs-filter-tabs" role="group" aria-label="Section filters">
                    <button type="button" class="@(SectionFilter == SectionFilterMode.All ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.All)">
                        All
                    </button>
                    @if (ShouldShowDefaultReviewRequiredTab)
                    {
                        <button type="button" class="@(SectionFilter == SectionFilterMode.ReviewRequired ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.ReviewRequired)">
                            Review Required
                        </button>
                    }
                    @foreach (var customTab in ConfiguredSectionTabs)
                    {
                        <button type="button"
                                class="@((SectionFilter == SectionFilterMode.CustomPattern && string.Equals(ActiveCustomTabName, customTab.Name, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty)"
                                @onclick="() => SetCustomSectionFilter(customTab.Name)">
                            @customTab.Name
                        </button>
                    }
                </div>
                @if (AvailableSourceFiles.Count > 0)
                {
                    <div class="srs-source-tags" role="group" aria-label="Selected source files">
                        <button type="button" class="srs-source-chip @(string.IsNullOrWhiteSpace(_selectedSourceFile) ? "active" : string.Empty)" @onclick="ShowAllSourceFiles">All files</button>
                        @foreach (var sourceFile in AvailableSourceFiles)
                        {
                            var isActiveSource = string.Equals(_selectedSourceFile, sourceFile, StringComparison.OrdinalIgnoreCase);
                            <span class="srs-source-chip-wrap @(isActiveSource ? "active" : string.Empty)">
                                <button type="button" class="srs-source-chip" @onclick="() => SelectSourceFile(sourceFile)">
                                    @sourceFile
                                </button>
                                <button type="button"
                                        class="srs-source-chip-remove"
                                        title="Remove file from list"
                                        aria-label="Remove @sourceFile"
                                        @onclick="() => RemoveSourceFileFromList(sourceFile)"
                                        @onclick:stopPropagation="true">
                                    ×
                                </button>
                            </span>
                        }
                    </div>
                }
                <div class="srs-sections-list">
                    @if (filteredSections.Count == 0)
                    {
                        <div class="srs-empty-list">No sections match.</div>
                    }
                    else
                    {
                        @foreach (var sectionItem in filteredSections)
                        {
                            var isActive = sectionItem.Id == SelectedSectionId;
                            var isScanning = sectionItem.Id == FullScanActiveSectionId;
                            var isScanned = !isScanning && _reviewCache.ContainsKey(sectionItem.Id);
                            var rowClass = isActive ? "active" : isScanning ? "scanning" : isScanned ? "scan-done" : string.Empty;
                            <button type="button"
                                    class="srs-section-row @rowClass"
                                    @onclick="() => SelectSection(sectionItem.Id)">
                                <span class="srs-letter-badge">@sectionItem.Letter</span>
                                <span class="srs-section-main">
                                    <span class="srs-section-title">@sectionItem.Heading</span>
                                    <span class="srs-line-meta srs-line-meta-source">@sectionItem.SourceFile</span>
                                    <span class="srs-line-meta">Line @(sectionItem.LineStart)</span>
                                </span>
                                @if (isScanning)
                                {
                                    <span class="srs-scan-indicator srs-scan-indicator--active"></span>
                                }
                                else if (isScanned)
                                {
                                    <span class="srs-scan-indicator srs-scan-indicator--done">✓</span>
                                }
                            </button>
                        }
                    }
                </div>
            </aside>

            <main class="srs-focus-panel">
                @if (selectedSection is null)
                {
                    <div class="srs-empty-center">Select a section to review.</div>
                }
                else
                {
                    <div class="srs-focus-workspace">
                        <section class="srs-ai-review-pane">
                            <div class="srs-stage-title">AI Review</div>

                            @if (IsRunningAiReview && SpokeResults.Count == 0)
                            {
                                <div class="srs-ai-review-card">
                                    <div class="srs-ai-empty">
                                        <span class="srs-ai-spinner srs-ai-spinner--sm"></span>
                                        <p>@(ActiveRoutingMode == RoutingMode.Dynamic ? "Hub deciding which checks to run…" : "Starting…")</p>
                                    </div>
                                </div>
                            }
                            else if (SpokeResults.Count > 0)
                            {
                                @for (var i = 0; i < SpokeResults.Count; i++)
                                {
                                    var result = SpokeResults[i];
                                    var step = i < CurrentSteps.Count ? CurrentSteps[i] : null;
                                    var stepLabel = string.IsNullOrWhiteSpace(result.Label) ? $"Check {i + 1}" : result.Label;

                                    <div class="srs-ai-step-card">
                                        <div class="srs-ai-step-header">
                                            <span class="srs-ai-step-label">@stepLabel</span>
                                            @if (result.Status == SpokeStatus.Running)
                                            {
                                                <div class="srs-ai-spinner"></div>
                                            }
                                            else if (result.Status == SpokeStatus.Done)
                                            {
                                                <span class="srs-ai-badge srs-ai-badge--yes">Done</span>
                                            }
                                            else if (result.Status == SpokeStatus.Failed)
                                            {
                                                <span class="srs-ai-badge srs-ai-badge--no">Failed</span>
                                            }
                                        </div>

                                        @if (result.Status == SpokeStatus.Pending)
                                        {
                                            <div class="srs-ai-step-thinking srs-ai-step-waiting">Waiting…</div>
                                        }
                                        else if (result.Status == SpokeStatus.Running && string.IsNullOrWhiteSpace(result.RawResult))
                                        {
                                            <div class="srs-ai-step-thinking">Analysing…</div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(result.Error))
                                        {
                                            <div class="srs-ai-error">@result.Error</div>
                                        }
                                        else if (result.Parsed is not null && step?.OutputSchema is not null)
                                        {
                                            <div class="srs-ai-structured">
                                                @foreach (var field in step.OutputSchema.Fields)
                                                {
                                                    var hasValue = result.Parsed.TryGetValue(field.Key, out var val);
                                                    var isEmptyList = field.Type == "list" && hasValue &&
                                                                      val.ValueKind == System.Text.Json.JsonValueKind.Array &&
                                                                      !val.EnumerateArray().Any();
                                                    var isMissingNonBoolean = field.Type != "boolean" && !hasValue;

                                                    if (isEmptyList || isMissingNonBoolean) continue;

                                                    <div class="srs-ai-field">
                                                        <div class="srs-ai-field-label">@field.Label</div>
                                                        @if (field.Type == "boolean")
                                                        {
                                                            var isTrue = hasValue && (val.ValueKind == System.Text.Json.JsonValueKind.True ||
                                                                         (val.ValueKind == System.Text.Json.JsonValueKind.String &&
                                                                          val.GetString()?.Equals("true", StringComparison.OrdinalIgnoreCase) == true));
                                                            <span class="srs-ai-badge @(isTrue ? "srs-ai-badge--yes" : "srs-ai-badge--no")">
                                                                @(isTrue ? "Yes" : "No")
                                                            </span>
                                                        }
                                                        else if (field.Type == "list")
                                                        {
                                                            <ul class="srs-ai-field-list">
                                                                @if (val.ValueKind == System.Text.Json.JsonValueKind.Array)
                                                                {
                                                                    foreach (var item in val.EnumerateArray())
                                                                    {
                                                                        <li>@FormatInlineMarkup(JsonElementToDisplay(item))</li>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <li>@FormatInlineMarkup(JsonElementToDisplay(val))</li>
                                                                }
                                                            </ul>
                                                        }
                                                        else if (field.Type == "table")
                                                        {
                                                            @if (val.ValueKind == System.Text.Json.JsonValueKind.Array)
                                                            {
                                                                var rows = val.EnumerateArray().ToList();
                                                                var cols = rows.Count > 0
                                                                    ? rows[0].EnumerateObject().Select(p => p.Name).ToList()
                                                                    : new List<string>();
                                                                @if (cols.Count > 0)
                                                                {
                                                                    var isPocoComparison = cols.Contains("status") && cols.Contains("rectification_prompt");
                                                                    var hiddenCompactCols = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
                                                                    {
                                                                        "in_db", "in_poco", "error_message"
                                                                    };
                                                                    var displayCols = isPocoComparison
                                                                        ? cols.Where(c => !hiddenCompactCols.Contains(c)).ToList()
                                                                        : cols;
                                                                    <div class="srs-ai-table-wrap">
                                                                        <table class="srs-ai-table">
                                                                            <thead>
                                                                                <tr>
                                                                                    @foreach (var col in displayCols)
                                                                                    {
                                                                                        <th>@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(col.Replace("_", " "))</th>
                                                                                    }
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var row in rows)
                                                                                {
                                                                                    var rowStatus = row.TryGetProperty("status", out var statusVal)
                                                                                        ? JsonElementToDisplay(statusVal)
                                                                                        : string.Empty;
                                                                                    var rowClass = rowStatus.Equals("MISSING_IN_POCO", StringComparison.OrdinalIgnoreCase)
                                                                                        ? "srs-ai-row-missing-poco"
                                                                                        : string.Empty;
                                                                                    <tr class="@rowClass">
                                                                                        @foreach (var col in displayCols)
                                                                                        {
                                                                                            var cellVal = row.TryGetProperty(col, out var cv) ? JsonElementToDisplay(cv) : "-";
                                                                                            <td>@((MarkupString)FormatInline(cellVal))</td>
                                                                                        }
                                                                                    </tr>
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                }
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="srs-ai-field-text">@JsonElementToDisplay(val)</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(result.RawResult))
                                        {
                                            <div class="srs-ai-result srs-markdown">@((MarkupString)RenderMarkdown(result.RawResult))</div>
                                        }
                                    </div>
                                }
                            }
                            else if (CurrentSectionHasAiSupport)
                            {
                                <div class="srs-ai-review-card">
                                    <div class="srs-ai-empty">
                                        <div class="srs-ai-empty-icon">AI</div>
                                        <p>Click <strong>Run AI Review</strong> above to start.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="srs-ai-review-card">
                                    <div class="srs-ai-empty srs-ai-empty--no-prompt">
                                        <div class="srs-ai-empty-icon srs-ai-empty-icon--muted">AI</div>
                                        <p>No AI prompt configured for this section. Switch to <strong>Dynamic</strong> to let the hub decide.</p>
                                    </div>
                                </div>
                            }
                        </section>

                        <section class="srs-details-pane">
                            <section class="srs-stage-card" aria-label="Section details">
                                <div class="srs-stage-title">Section details</div>
                                <div class="srs-focus-header">
                                    <div class="srs-focus-title-row">
                                        <span class="srs-letter-badge large">@selectedSection.Letter</span>
                                        <div class="srs-focus-title">
                                            <h2>@selectedSection.Heading</h2>
                                            <div class="srs-source-file-badge">@selectedSection.SourceFile</div>
                                            <div class="srs-center-meta">Line @(selectedSection.LineStart) - @(selectedSection.LineCount) lines</div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="srs-document-card">
                                <div class="srs-section-label-row">
                                    <span class="srs-panel-label">Section content</span>
                                    <div class="srs-section-actions">
                                        <span>Original markdown</span>
                                        <button type="button" class="srs-btn srs-btn-ghost" @onclick="CopyCurrentSectionContentAsync">Copy</button>
                                        @if (CurrentSectionIsRazorPage)
                                        {
                                            <button type="button" class="srs-btn srs-btn-primary" @onclick="RunDevExpressPropertyValidationAsync" disabled="@IsRunningAiReview">
                                                Validate DevExpress Properties
                                            </button>
                                            <button type="button" class="srs-btn srs-btn-ghost" @onclick="GenerateRazorMockScreen">Generate Mock (Fast)</button>
                                            <button type="button" class="srs-btn srs-btn-primary" @onclick="GenerateRazorMockScreenWithAiAsync" disabled="@IsGeneratingAiMock">
                                                @(IsGeneratingAiMock ? "Generating AI Design..." : "Generate Mock (AI Design)")
                                            </button>
                                            <button type="button" class="srs-btn srs-btn-ghost" @onclick="GenerateRazorMockComparisonAsync" disabled="@IsGeneratingComparison">
                                                @(IsGeneratingComparison ? "Generating Comparison..." : "Generate Comparison")
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="srs-markdown">
                                    @((MarkupString)RenderMarkdown(selectedSection.Content, ActiveHighlightTerms))
                                </div>
                                @if (IsGeneratingComparison || ComparisonProgressPercent > 0)
                                {
                                    <div class="srs-compare-progress">
                                        <div class="srs-compare-progress-head">
                                            <span>@(string.IsNullOrWhiteSpace(ComparisonProgressLabel) ? "Generating comparison..." : ComparisonProgressLabel)</span>
                                            <span>@ComparisonProgressPercent%</span>
                                        </div>
                                        <div class="srs-compare-progress-track">
                                            <div class="srs-compare-progress-fill" style="width:@($"{ComparisonProgressPercent}%")"></div>
                                        </div>
                                    </div>
                                }
                            </section>

                            <section class="srs-document-card">
                                <div class="srs-section-label-row">
                                    <span class="srs-panel-label">Generated mock</span>
                                    <div class="srs-section-actions">
                                        <span>Razor parser preview</span>
                                        <button type="button" class="srs-btn srs-btn-ghost" @onclick="CaptureGeneratedMockAsync" disabled="@(GeneratedMockScreen is null || IsCapturingMockPng)">
                                            @(IsCapturingMockPng ? "Capturing..." : "Capture PNG")
                                        </button>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(MockGeneratorError))
                                {
                                    <div class="srs-mock-empty">@MockGeneratorError</div>
                                }
                                else if (GeneratedMockScreen is null)
                                {
                                    <div class="srs-mock-empty">Click "Generate Mock (AI Design)" to build a design-oriented mock from Razor code.</div>
                                }
                                else
                                {
                                    <div class="srs-mock-preview">
                                        <div class="srs-mock-render" id="srs-generated-mock-render">
                                            @((MarkupString)GeneratedMockHtml)
                                        </div>
                                        <div class="srs-mock-json-wrap">
                                            <pre class="srs-mock-json"><code>@GeneratedMockJson</code></pre>
                                        </div>
                                    </div>
                                }
                            </section>

                            @if (!string.IsNullOrWhiteSpace(ComparisonReportMarkdown))
                            {
                                <section class="srs-document-card">
                                    <div class="srs-section-label-row">
                                        <span class="srs-panel-label">Razor vs Mockup Comparison</span>
                                        <span>Deterministic comparison report</span>
                                    </div>
                                    @if (TryGetComparisonStructurePanels(out var razorStructure, out var mockupStructure))
                                    {
                                        <div class="srs-compare-vertical">
                                            <article class="srs-compare-panel">
                                                <h4>Razor</h4>
                                                <pre><code>@razorStructure</code></pre>
                                            </article>
                                            <article class="srs-compare-panel">
                                                <h4>Mockup</h4>
                                                <pre><code>@mockupStructure</code></pre>
                                            </article>
                                        </div>
                                    }
                                    <div class="srs-markdown">
                                        @((MarkupString)RenderMarkdown(ComparisonReportMarkdown))
                                    </div>
                                </section>
                            }

                            @if (ShowMockAttachmentPicker)
                            {
                                <section class="srs-document-card" id="srs-mock-attachment-picker">
                                    <div class="srs-section-label-row">
                                        <span class="srs-panel-label">Select Mock Attachment</span>
                                        <span>Story #@ActiveStory?.Id</span>
                                    </div>
                                    <div class="srs-mock-picker">
                                        @foreach (var attachment in AvailableMockAttachments)
                                        {
                                            var optionId = $"mock-{attachment.Url.GetHashCode()}";
                                            <label class="srs-mock-option" for="@optionId">
                                                <input id="@optionId"
                                                       type="radio"
                                                       name="mockAttachment"
                                                       checked="@string.Equals(SelectedMockAttachmentUrl, attachment.Url, StringComparison.OrdinalIgnoreCase)"
                                                       @onchange="@(() => SelectedMockAttachmentUrl = attachment.Url)" />
                                                <span class="srs-mock-option-text">
                                                    <strong>@attachment.Name</strong>
                                                    <span class="srs-line-meta">@attachment.DisplaySize | @attachment.AttachedBy | @attachment.DisplayAttachedOn</span>
                                                </span>
                                            </label>
                                        }
                                        <div class="srs-mock-picker-actions">
                                            <button type="button" class="srs-btn srs-btn-primary" @onclick="ConfirmMockAttachmentComparisonAsync" disabled="@IsGeneratingComparison">
                                                @(IsGeneratingComparison ? "Generating Comparison..." : "Compare with Selected Mock")
                                            </button>
                                            <button type="button" class="srs-btn srs-btn-ghost" @onclick="CancelMockAttachmentPicker">Cancel</button>
                                        </div>
                                    </div>
                                </section>
                            }
                        </section>

                        </div>
                }
            </main>
        </div>
    </div>
}



