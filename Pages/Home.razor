@page "/"
@using System.Text
@using System.Text.RegularExpressions
@inject IJSRuntime JS

<PageTitle>Smart Review System</PageTitle>

@if (!HasFileLoaded)
{
    <div class="srs-upload-screen">
        <div class="srs-dropzone @(IsDragging ? "dragging" : string.Empty)"
             @ondragenter="OnDragEnter"
             @ondragover="OnDragOver"
             @ondragleave="OnDragLeave"
             @ondrop="OnDrop"
             @ondragenter:preventDefault="true"
             @ondragover:preventDefault="true"
             @ondragleave:preventDefault="true"
             @ondrop:preventDefault="true">
            <InputFile OnChange="HandleFileSelected" accept=".md,.txt,.markdown" class="srs-file-input" />
            <div class="srs-upload-icon">UP</div>
            <h2>Drop your .md plan file here</h2>
            <p>or click to browse</p>
            <p class="srs-upload-hint">Accepted: <code>.md</code>, <code>.txt</code>, <code>.markdown</code></p>
            @if (!string.IsNullOrWhiteSpace(UploadError))
            {
                <p class="srs-error">@UploadError</p>
            }
        </div>
    </div>
}
else
{
    var selectedSection = CurrentSection;
    var selectedViolations = selectedSection is null
        ? new List<Violation>()
        : GetViolationsForSection(selectedSection.Id);
    var selectedErrorCount = selectedViolations.Count(v => IsSeverity(v.Severity, "error"));
    var selectedWarningCount = selectedViolations.Count(v => IsSeverity(v.Severity, "warning"));
    var selectedInfoCount = selectedViolations.Count(v => IsSeverity(v.Severity, "info"));
    var filteredSections = FilteredSections.ToList();

    <div class="srs-app">
        <header class="srs-topbar">
            <div class="srs-topbar-left">
                <span class="srs-file-pill">@UploadedFileName</span>
                <span class="srs-count-pill">@Sections.Count sections</span>
                <span class="srs-count-pill danger">@TotalIssueCount issues</span>
            </div>
            <div class="srs-topbar-actions">
                <button type="button" class="srs-btn srs-btn-primary" @onclick="OpenRevisionPromptModal" disabled="@(TotalIssueCount == 0)">
                    Generate Revision Prompt
                </button>
                <button type="button" class="srs-btn srs-btn-ghost" @onclick="ResetAll">Close</button>
            </div>
        </header>

        <div class="srs-review-shell">
            <aside class="srs-left-panel">
                <div class="srs-sidebar-head">
                    <div>
                        <div class="srs-panel-label">Sections</div>
                        <div class="srs-sidebar-summary">@CleanSectionCount clean / @Sections.Count total</div>
                    </div>
                </div>
                <input class="srs-section-search"
                       placeholder="Search sections"
                       @bind="SectionSearchText"
                       @bind:event="oninput" />
                <div class="srs-filter-tabs" role="group" aria-label="Section filters">
                    <button type="button" class="@(SectionFilter == SectionFilterMode.All ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.All)">
                        All
                    </button>
                    <button type="button" class="@(SectionFilter == SectionFilterMode.Issues ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.Issues)">
                        Issues
                    </button>
                    <button type="button" class="@(SectionFilter == SectionFilterMode.Clean ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.Clean)">
                        Clean
                    </button>
                </div>
                <div class="srs-sections-list">
                    @if (filteredSections.Count == 0)
                    {
                        <div class="srs-empty-list">No sections match.</div>
                    }
                    else
                    {
                        @foreach (var sectionItem in filteredSections)
                        {
                            var status = GetSectionStatus(sectionItem.Id);
                            var isActive = sectionItem.Id == SelectedSectionId;
                            <button type="button"
                                    class="srs-section-row @(isActive ? "active" : string.Empty)"
                                    @onclick="() => SelectSection(sectionItem.Id)">
                                <span class="srs-letter-badge">@sectionItem.Letter</span>
                                <span class="srs-section-main">
                                    <span class="srs-section-title">@sectionItem.Heading</span>
                                    <span class="srs-line-meta">Line @(sectionItem.LineStart)</span>
                                </span>
                                <span class="srs-violation-pill @status.CssClass">@status.BadgeText</span>
                            </button>
                        }
                    }
                </div>
            </aside>

            <main class="srs-focus-panel">
                @if (selectedSection is null)
                {
                    <div class="srs-empty-center">Select a section to review.</div>
                }
                else
                {
                    <div class="srs-focus-header">
                        <div class="srs-focus-title-row">
                            <span class="srs-letter-badge large">@selectedSection.Letter</span>
                            <div class="srs-focus-title">
                                <h2>@selectedSection.Heading</h2>
                                <div class="srs-center-meta">Line @(selectedSection.LineStart) - @(selectedSection.LineCount) lines</div>
                            </div>
                        </div>
                        <div class="srs-section-nav">
                            <button type="button" class="srs-btn srs-btn-ghost" @onclick="() => SelectAdjacentIssue(-1)" disabled="@(!HasAdjacentIssue(-1))">
                                Previous issue
                            </button>
                            <button type="button" class="srs-btn srs-btn-ghost" @onclick="() => SelectAdjacentIssue(1)" disabled="@(!HasAdjacentIssue(1))">
                                Next issue
                            </button>
                        </div>
                    </div>

                    <section class="srs-conclusion-card @(selectedViolations.Count == 0 ? "clean" : "needs-work")">
                        <div>
                            <div class="srs-conclusion-kicker">Conclusion</div>
                            <h3>@GetSectionConclusion(selectedViolations)</h3>
                            <p>@GetSectionAction(selectedViolations)</p>
                        </div>
                        <div class="srs-conclusion-stats">
                            <span>@selectedErrorCount errors</span>
                            <span>@selectedWarningCount warnings</span>
                            <span>@selectedInfoCount info</span>
                        </div>
                    </section>

                    @if (selectedViolations.Count > 0)
                    {
                        <section class="srs-fix-list" aria-label="Fix checklist">
                            <div class="srs-section-label-row">
                                <span class="srs-panel-label">Fix checklist</span>
                                <span>@selectedViolations.Count item@(selectedViolations.Count == 1 ? string.Empty : "s")</span>
                            </div>
                            @for (var i = 0; i < selectedViolations.Count; i++)
                            {
                                var violation = selectedViolations[i];
                                var reasonKey = BuildReasonKey(selectedSection.Id, violation, i);
                                var reasonExpanded = ExpandedReasonKeys.Contains(reasonKey);
                                <article class="srs-fix-item @GetSeverityClass(violation.Severity)">
                                    <div class="srs-fix-heading">
                                        <span class="srs-rule-id @GetSeverityClass(violation.Severity)">@violation.RuleId</span>
                                        <span>@violation.Title</span>
                                    </div>
                                    <div class="srs-fix-text">@violation.Fix</div>
                                    <button type="button"
                                            class="srs-btn srs-btn-ghost srs-reason-toggle"
                                            @onclick="() => ToggleReason(reasonKey)">
                                        @(reasonExpanded ? "Hide evidence" : "Show evidence")
                                    </button>
                                    @if (reasonExpanded)
                                    {
                                        <div class="srs-reason-box">
                                            <div class="srs-detail-label">Matched</div>
                                            <div class="srs-matched-text">@TruncateForDisplay(violation.Matched, 120)</div>
                                            <div class="srs-detail-label">Reason</div>
                                            <div>@violation.Reason</div>
                                        </div>
                                    }
                                </article>
                            }
                        </section>
                    }

                    <section class="srs-document-card">
                        <div class="srs-section-label-row">
                            <span class="srs-panel-label">Section content</span>
                            <span>Original markdown</span>
                        </div>
                        <div class="srs-markdown">
                            @((MarkupString)RenderMarkdown(selectedSection.Content))
                        </div>
                    </section>
                }
            </main>
        </div>
    </div>
}

@if (ShowRevisionModal)
{
    <div class="srs-modal-overlay" @onclick="CloseRevisionPromptModal">
        <div class="srs-modal-card" @onclick:stopPropagation="true">
            <div class="srs-modal-header">
                <h3>Revision Prompt</h3>
                <button type="button" class="srs-btn srs-btn-ghost" @onclick="CloseRevisionPromptModal">Close</button>
            </div>
            <div class="srs-modal-body">
                <pre>@RevisionPromptText</pre>
            </div>
            <div class="srs-modal-footer">
                <button type="button" class="srs-btn srs-btn-primary" @onclick="CopyRevisionPromptAsync">@CopyButtonLabel</button>
                <button type="button" class="srs-btn srs-btn-ghost" @onclick="CloseRevisionPromptModal">Close</button>
            </div>
        </div>
    </div>
}

<style>
    :root {
        --srs-text-primary: var(--color-text-primary, #111827);
        --srs-text-secondary: var(--color-text-secondary, #374151);
        --srs-text-tertiary: var(--color-text-tertiary, #6b7280);
        --srs-text-info: var(--color-text-info, #2563eb);
        --srs-bg-primary: var(--color-background-primary, #ffffff);
        --srs-bg-secondary: var(--color-background-secondary, #f9fafb);
        --srs-bg-info: var(--color-background-info, #dbeafe);
        --srs-bg-success: var(--color-background-success, #dcfce7);
        --srs-border-secondary: var(--color-border-secondary, #d1d5db);
        --srs-border-tertiary: var(--color-border-tertiary, #e5e7eb);
        --srs-radius-md: var(--border-radius-md, 8px);
        --srs-radius-lg: var(--border-radius-lg, 10px);
        --srs-mono: var(--font-mono, "Consolas", "SFMono-Regular", "Menlo", monospace);
    }

    html, body, .main-host {
        height: 100%;
        margin: 0;
        background: #f6f7f9;
        color: var(--srs-text-primary);
        font-family: "Segoe UI", "Noto Sans", Arial, sans-serif;
    }

    .main-host {
        display: block;
    }

    .srs-upload-screen {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .srs-dropzone {
        width: min(760px, 100%);
        min-height: 280px;
        border: 2px dashed var(--srs-border-secondary);
        border-radius: var(--srs-radius-lg);
        background: var(--srs-bg-primary);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        padding: 2rem;
        position: relative;
        transition: border-color 120ms ease, background-color 120ms ease, transform 120ms ease;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        text-align: center;
    }

    .srs-dropzone.dragging {
        border-color: #16a34a;
        background: color-mix(in srgb, var(--srs-bg-success) 78%, white 22%);
        transform: translateY(-2px);
    }

    .srs-file-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .srs-upload-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: color-mix(in srgb, var(--srs-bg-info) 72%, white 28%);
        display: grid;
        place-items: center;
        color: var(--srs-text-info);
        font-size: 1.4rem;
        font-weight: 700;
    }

    .srs-dropzone h2 {
        margin: 0;
        font-size: 1.28rem;
    }

    .srs-dropzone p {
        margin: 0;
        color: var(--srs-text-secondary);
    }

    .srs-upload-hint {
        font-size: 0.9rem;
        color: var(--srs-text-tertiary);
    }

    .srs-error {
        color: #b91c1c;
        font-weight: 600;
    }

    .srs-app {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .srs-topbar {
        height: 58px;
        padding: 0 1.1rem;
        border-bottom: 1px solid var(--srs-border-tertiary);
        background: var(--srs-bg-primary);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        position: sticky;
        top: 0;
        z-index: 20;
    }

    .srs-topbar-left {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-width: 0;
    }

    .srs-file-pill {
        display: inline-block;
        max-width: min(680px, 58vw);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        border: 1px solid var(--srs-border-tertiary);
        border-radius: var(--srs-radius-md);
        padding: 0.34rem 0.65rem;
        background: #fafafa;
        font-weight: 600;
    }

    .srs-count-pill {
        border-radius: 999px;
        padding: 0.24rem 0.55rem;
        background: #eef2ff;
        color: var(--srs-text-info);
        font-size: 0.78rem;
        font-weight: 700;
        border: 1px solid #dbe4ff;
        line-height: 1;
    }

    .srs-count-pill.danger {
        background: #fff1f2;
        border-color: #fecdd3;
        color: #be123c;
    }

    .srs-topbar-actions {
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .srs-review-shell {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
    }

    .srs-left-panel {
        border-right: 1px solid var(--srs-border-tertiary);
        background: #fbfcfd;
        padding: 0.75rem 0.65rem;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .srs-sidebar-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.65rem;
    }

    .srs-sidebar-summary {
        margin-top: 0.18rem;
        color: var(--srs-text-tertiary);
        font-size: 0.78rem;
    }

    .srs-panel-label {
        color: var(--srs-text-tertiary);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .srs-section-search {
        width: 100%;
        height: 38px;
        border: 1px solid var(--srs-border-tertiary);
        border-radius: 8px;
        background: var(--srs-bg-primary);
        color: var(--srs-text-primary);
        padding: 0 0.72rem;
        font-size: 0.88rem;
        outline: none;
    }

    .srs-section-search:focus {
        border-color: #93b4ee;
        box-shadow: 0 0 0 3px #dbeafe;
    }

    .srs-filter-tabs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.25rem;
        margin-top: 0.55rem;
        padding: 0.2rem;
        border: 1px solid var(--srs-border-tertiary);
        border-radius: 9px;
        background: #f3f4f6;
    }

    .srs-filter-tabs button {
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: var(--srs-text-tertiary);
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 650;
        padding: 0.34rem 0.3rem;
    }

    .srs-filter-tabs button.active {
        background: var(--srs-bg-primary);
        color: var(--srs-text-primary);
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
    }

    .srs-sections-list {
        margin-top: 0.7rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        overflow-y: auto;
        padding-right: 0.1rem;
    }

    .srs-empty-list {
        color: var(--srs-text-tertiary);
        font-size: 0.86rem;
        padding: 0.7rem 0.25rem;
    }

    .srs-section-row {
        width: 100%;
        border: 0;
        border-radius: 7px;
        background: transparent;
        display: grid;
        grid-template-columns: 22px minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.42rem;
        padding: 0.42rem 0.48rem;
        cursor: pointer;
        text-align: left;
        color: inherit;
    }

    .srs-section-row:hover {
        background: #f3f6fb;
    }

    .srs-section-row.active {
        background: #eef4ff;
        box-shadow: inset 3px 0 0 var(--srs-text-info);
    }

    .srs-section-row.active .srs-section-title {
        color: var(--srs-text-info);
        font-weight: 700;
    }

    .srs-letter-badge {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        background: var(--srs-bg-primary);
        border: 1px solid var(--srs-border-tertiary);
        display: inline-grid;
        place-items: center;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--srs-text-secondary);
    }

    .srs-letter-badge.large {
        width: 30px;
        height: 30px;
        font-size: 0.88rem;
    }

    .srs-section-main {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .srs-section-title {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.86rem;
        font-weight: 600;
    }

    .srs-line-meta {
        margin-top: 1px;
        font-family: var(--srs-mono);
        font-size: 0.72rem;
        color: var(--srs-text-tertiary);
    }

    .srs-violation-pill {
        font-family: var(--srs-mono);
        font-size: 0.7rem;
        border-radius: 999px;
        padding: 0.12rem 0.42rem;
        border: 1px solid transparent;
        min-width: 2.3rem;
        text-align: center;
    }

    .srs-badge-error {
        background: #fee2e2;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .srs-badge-warning {
        background: #fef3c7;
        color: #92400e;
        border-color: #fcd34d;
    }

    .srs-badge-clean {
        background: color-mix(in srgb, var(--srs-bg-success) 75%, white 25%);
        color: #166534;
        border-color: #86efac;
    }

    .srs-focus-panel {
        min-width: 0;
        overflow-y: auto;
        padding: 1.15rem 1.4rem 1.6rem;
        background: #f6f7f9;
    }

    .srs-empty-center {
        color: var(--srs-text-tertiary);
    }

    .srs-focus-header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1rem;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.85rem;
    }

    .srs-focus-title-row {
        display: flex;
        align-items: center;
        gap: 0.56rem;
        min-width: 0;
    }

    .srs-focus-title {
        min-width: 0;
    }

    .srs-focus-title h2 {
        margin: 0;
        font-size: 1.18rem;
        min-width: 0;
        line-height: 1.25;
    }

    .srs-center-meta {
        color: var(--srs-text-tertiary);
        font-family: var(--srs-mono);
        font-size: 0.79rem;
    }

    .srs-section-nav {
        display: flex;
        gap: 0.45rem;
        align-items: center;
    }

    .srs-divider {
        margin: 0.8rem 0 1.1rem;
        border-bottom: 1px solid var(--srs-border-tertiary);
    }

    .srs-conclusion-card,
    .srs-fix-list,
    .srs-document-card {
        background: var(--srs-bg-primary);
        border: 1px solid var(--srs-border-tertiary);
        border-radius: 10px;
        margin-bottom: 0.85rem;
    }

    .srs-conclusion-card {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem;
    }

    .srs-conclusion-card.needs-work {
        border-left: 4px solid #dc2626;
    }

    .srs-conclusion-card.clean {
        border-left: 4px solid #16a34a;
    }

    .srs-conclusion-kicker {
        color: var(--srs-text-tertiary);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .srs-conclusion-card h3 {
        margin: 0.18rem 0 0;
        color: var(--srs-text-primary);
        font-size: 1rem;
    }

    .srs-conclusion-card p {
        margin: 0.35rem 0 0;
        color: var(--srs-text-secondary);
        line-height: 1.45;
    }

    .srs-conclusion-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        justify-content: flex-end;
        min-width: 170px;
    }

    .srs-conclusion-stats span {
        border: 1px solid var(--srs-border-tertiary);
        border-radius: 999px;
        color: var(--srs-text-secondary);
        background: #fafafa;
        font-size: 0.76rem;
        font-weight: 650;
        padding: 0.22rem 0.48rem;
    }

    .srs-section-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.72rem 0.88rem;
        border-bottom: 1px solid var(--srs-border-tertiary);
        color: var(--srs-text-tertiary);
        font-size: 0.8rem;
    }

    .srs-fix-list {
        overflow: hidden;
    }

    .srs-fix-item {
        border-bottom: 1px solid var(--srs-border-tertiary);
        padding: 0.82rem 0.9rem;
        display: grid;
        gap: 0.42rem;
    }

    .srs-fix-item:last-child {
        border-bottom: 0;
    }

    .srs-fix-item.severity-error {
        box-shadow: inset 3px 0 0 #dc2626;
    }

    .srs-fix-item.severity-warning {
        box-shadow: inset 3px 0 0 #d97706;
    }

    .srs-fix-item.severity-info {
        box-shadow: inset 3px 0 0 #2563eb;
    }

    .srs-fix-heading {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        align-items: flex-start;
        color: var(--srs-text-primary);
        font-weight: 700;
        line-height: 1.35;
    }

    .srs-document-card {
        overflow: hidden;
    }

    .srs-markdown {
        color: var(--srs-text-secondary);
        line-height: 1.62;
        font-size: 0.94rem;
        max-width: 1120px;
        padding: 0.95rem 1rem 1.1rem;
    }

    .srs-markdown h2,
    .srs-markdown h3,
    .srs-markdown h4 {
        color: var(--srs-text-primary);
        margin-top: 1.1rem;
        margin-bottom: 0.45rem;
    }

    .srs-markdown h2 {
        font-size: 1.16rem;
    }

    .srs-markdown h3 {
        font-size: 1.05rem;
    }

    .srs-markdown h4 {
        font-size: 0.98rem;
    }

    .srs-markdown p {
        margin: 0.42rem 0;
