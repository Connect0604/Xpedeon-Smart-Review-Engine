@page "/"

<PageTitle>Smart Review System</PageTitle>

@if (!HasFileLoaded)
{
    <div class="srs-upload-screen">
        <div class="srs-workspace-header">
            <div class="srs-workspace-row">
                <div class="srs-source-switch" role="group" aria-label="Upload source">
                    <button type="button" class="@(CurrentUploadSource == UploadSource.AzureDevOps ? "active" : string.Empty)" @onclick="() => SetUploadSource(UploadSource.AzureDevOps)">Azure DevOps</button>
                    <button type="button" class="@(CurrentUploadSource == UploadSource.Local ? "active" : string.Empty)" @onclick="() => SetUploadSource(UploadSource.Local)">Local upload</button>
                </div>
                <div class="srs-context-pill">@ActiveContextLabel</div>
            </div>
        </div>

        @if (CurrentUploadSource == UploadSource.Local)
        {
            <div class="srs-dropzone @(IsDragging ? "dragging" : string.Empty)"
                 @ondragenter="OnDragEnter"
                 @ondragover="OnDragOver"
                 @ondragleave="OnDragLeave"
                 @ondrop="OnDrop"
                 @ondragenter:preventDefault="true"
                 @ondragover:preventDefault="true"
                 @ondragleave:preventDefault="true"
                 @ondrop:preventDefault="true">
                <InputFile OnChange="HandleFileSelected" accept=".md,.txt,.markdown" class="srs-file-input" />
                <div class="srs-upload-icon">UP</div>
                <h2>Drop your .md plan file here</h2>
                <p>or click to browse</p>
                <p class="srs-upload-hint">Accepted: <code>.md</code>, <code>.txt</code>, <code>.markdown</code></p>
            </div>
        }
        else
        {
            <div class="srs-devops-panel">
                <div class="srs-panel-header">
                    <h2>Azure DevOps Story Explorer</h2>
                    <button type="button" class="srs-btn srs-btn-ghost" @onclick="() => IsDevOpsFiltersCollapsed = !IsDevOpsFiltersCollapsed">
                        @(IsDevOpsFiltersCollapsed ? "Show filters" : "Hide filters")
                    </button>
                </div>
                @if (!IsDevOpsFiltersCollapsed)
                {
                    <div class="srs-devops-grid">
                        <input class="srs-section-search" placeholder="Organization (e.g. your-org)" @bind="DevOpsOrganization" />
                        <input class="srs-section-search" placeholder="Project" @bind="DevOpsProject" />
                        <input class="srs-section-search" placeholder="PAT token (session only)" @bind="DevOpsPatToken" type="password" />
                    </div>
                    <div class="srs-guided-filters">
                        <input class="srs-section-search" placeholder="Tag contains (e.g. Master AI Development)" @bind="DevOpsTagFilter" />
                        <select class="srs-section-search" @bind="DevOpsStateFilter">
                            <option value="Any">Any state</option>
                            <option value="New">New</option>
                            <option value="Active">Active</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                            <option value="Testing Requested">Testing Requested</option>
                        </select>
                        <input class="srs-section-search" placeholder="Assigned to contains" @bind="DevOpsAssignedFilter" />
                    </div>
                    <div class="srs-devops-row">
                        <label class="srs-toggle">
                            <input type="checkbox" @bind="UseAdvancedWiql" />
                            <span>Use advanced WIQL</span>
                        </label>
                        <label class="srs-toggle">
                            <input type="checkbox" @bind="DevOpsOnlyWithAttachments" />
                            <span>Only stories with attachments</span>
                        </label>
                        <span class="srs-connection @($"status-{DevOpsConnectionStatus.ToLowerInvariant()}")">Connection: @DevOpsConnectionStatus</span>
                    </div>
                    @if (UseAdvancedWiql)
                    {
                        <textarea class="srs-devops-condition" @bind="DevOpsCondition"></textarea>
                    }
                }
                <button type="button" class="srs-btn srs-btn-primary srs-load-btn" @onclick="LoadStoriesFromDevOpsAsync" disabled="@IsLoadingStories">
                    @(IsLoadingStories ? "Loading..." : "Load user stories")
                </button>

                @if (DevOpsTotalStories > 0)
                {
                    <div class="srs-metric-grid">
                        <div class="srs-metric-card"><span>Stories</span><strong>@DevOpsTotalStories</strong></div>
                        <div class="srs-metric-card"><span>With Attachments</span><strong>@DevOpsStoriesWithAttachments</strong></div>
                        <div class="srs-metric-card"><span>Supported</span><strong>@DevOpsSupportedAttachmentCount</strong></div>
                        <div class="srs-metric-card"><span>Unsupported</span><strong>@DevOpsUnsupportedAttachmentCount</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(DevOpsUnsupportedExtensionSummary))
                    {
                        <details class="srs-devops-note-panel">
                            <summary>Why some files are not analyzable</summary>
                            <div class="srs-devops-note">Unsupported types: @DevOpsUnsupportedExtensionSummary</div>
                        </details>
                    }
                    @if (!string.IsNullOrWhiteSpace(DevOpsBuiltQuery))
                    {
                        <div class="srs-devops-note">Query used: <code>@DevOpsBuiltQuery</code></div>
                    }
                }

                @if (DevOpsStories.Count > 0)
                {
                    var filteredStories = FilteredDevOpsStories.ToList();
                    <input class="srs-section-search srs-devops-search" placeholder="Search in fetched stories (ID, title, assignee, tags)" @bind="DevOpsStorySearch" @bind:event="oninput" />
                    <div class="srs-story-list">
                        <table class="srs-devops-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Work Item Type</th>
                                    <th>Title</th>
                                    <th>Assigned To</th>
                                    <th>State</th>
                                    <th>Tags</th>
                                    <th>Attached Files</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var story in filteredStories)
                                {
                                    <tr>
                                        <td>@story.Id</td>
                                        <td>@story.WorkItemType</td>
                                        <td>@story.Title</td>
                                        <td>@story.AssignedTo</td>
                                        <td>@story.State</td>
                                        <td>@(string.IsNullOrWhiteSpace(story.Tags) ? "-" : story.Tags)</td>
                                        <td>
                                            @if (story.Attachments.Count == 0)
                                            {
                                                <span>No attachment</span>
                                            }
                                            else
                                            {
                                                <div class="srs-attachment-list">
                                                    @foreach (var typeGroup in story.Attachments
                                                        .Where(a => a.IsSupported)
                                                        .OrderBy(a => a.Extension, StringComparer.OrdinalIgnoreCase)
                                                        .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
                                                        .GroupBy(a => a.Extension, StringComparer.OrdinalIgnoreCase))
                                                    {
                                                        <details class="srs-filetype-group" open>
                                                            <summary>type: @typeGroup.Key.ToLowerInvariant() (@typeGroup.Count())</summary>
                                                            @foreach (var attachment in typeGroup)
                                                            {
                                                                <button type="button" class="srs-attachment-btn" @onclick="() => AnalyzeDevOpsAttachmentAsync(story, attachment)" disabled="@(!attachment.IsSupported)">
                                                                    <span>@attachment.Name</span>
                                                                    <span class="srs-attachment-meta">
                                                                        @attachment.DisplaySize | @attachment.AttachedBy | @attachment.DisplayAttachedOn
                                                                        @if (attachment.Name.EndsWith(".html", StringComparison.OrdinalIgnoreCase) || attachment.Name.EndsWith(".htm", StringComparison.OrdinalIgnoreCase))
                                                                        {
                                                                            <text> | open in browser</text>
                                                                        }
                                                                    </span>
                                                                </button>
                                                            }
                                                        </details>
                                                    }
                                                    @if (story.Attachments.Any(a => !a.IsSupported))
                                                    {
                                                        <details class="srs-unsupported-wrap">
                                                            <summary>unsupported files (@story.Attachments.Count(a => !a.IsSupported))</summary>
                                                            @foreach (var typeGroup in story.Attachments
                                                                .Where(a => !a.IsSupported)
                                                                .OrderBy(a => a.Extension, StringComparer.OrdinalIgnoreCase)
                                                                .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
                                                                .GroupBy(a => a.Extension, StringComparer.OrdinalIgnoreCase))
                                                            {
                                                                <details class="srs-filetype-group" open>
                                                                    <summary>type: @typeGroup.Key.ToLowerInvariant() (@typeGroup.Count())</summary>
                                                                    @foreach (var attachment in typeGroup)
                                                                    {
                                                                        <button type="button" class="srs-attachment-btn" disabled="true">
                                                                            <span>@attachment.Name</span>
                                                                            <span class="srs-attachment-meta">@attachment.DisplaySize | @attachment.AttachedBy | @attachment.DisplayAttachedOn | unsupported</span>
                                                                        </button>
                                                                    }
                                                                </details>
                                                            }
                                                        </details>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(UploadError))
        {
            <p class="srs-error">@UploadError</p>
        }
        @if (!string.IsNullOrWhiteSpace(DevOpsError))
        {
            <p class="srs-error">@DevOpsError</p>
        }
    </div>
}
else
{
    var selectedSection = CurrentSection;
    var selectedViolations = selectedSection is null
        ? new List<Violation>()
        : GetViolationsForSection(selectedSection.Id);
    var selectedErrorCount = selectedViolations.Count(v => IsSeverity(v.Severity, "error"));
    var selectedWarningCount = selectedViolations.Count(v => IsSeverity(v.Severity, "warning"));
    var selectedInfoCount = selectedViolations.Count(v => IsSeverity(v.Severity, "info"));
    var filteredSections = FilteredSections.ToList();

    <div class="srs-app">
        <header class="srs-topbar">
            <div class="srs-topbar-left">
                <span class="srs-file-pill">@UploadedFileName</span>
                <span class="srs-count-pill">@Sections.Count sections</span>
                <span class="srs-count-pill danger">@TotalIssueCount issues</span>
            </div>
            <div class="srs-topbar-actions">
                <button type="button" class="srs-btn srs-btn-primary" @onclick="OpenRevisionPromptModal" disabled="@(TotalIssueCount == 0)">
                    Generate Revision Prompt
                </button>
                <button type="button" class="srs-btn srs-btn-ghost" @onclick="ResetAll">Close</button>
            </div>
        </header>

        <div class="srs-review-shell">
            <aside class="srs-left-panel">
                <div class="srs-sidebar-head">
                    <div>
                        <div class="srs-panel-label">Sections</div>
                        <div class="srs-sidebar-summary">@CleanSectionCount clean / @Sections.Count total</div>
                    </div>
                </div>
                <input class="srs-section-search"
                       placeholder="Search sections"
                       @bind="SectionSearchText"
                       @bind:event="oninput" />
                <div class="srs-filter-tabs" role="group" aria-label="Section filters">
                    <button type="button" class="@(SectionFilter == SectionFilterMode.All ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.All)">
                        All
                    </button>
                    <button type="button" class="@(SectionFilter == SectionFilterMode.Issues ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.Issues)">
                        Issues
                    </button>
                    <button type="button" class="@(SectionFilter == SectionFilterMode.Clean ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.Clean)">
                        Clean
                    </button>
                    <button type="button" class="@(SectionFilter == SectionFilterMode.ReviewRequired ? "active" : string.Empty)" @onclick="() => SetSectionFilter(SectionFilterMode.ReviewRequired)">
                        Review Required
                    </button>
                </div>
                <div class="srs-sections-list">
                    @if (filteredSections.Count == 0)
                    {
                        <div class="srs-empty-list">No sections match.</div>
                    }
                    else
                    {
                        @foreach (var sectionItem in filteredSections)
                        {
                            var status = GetSectionStatus(sectionItem.Id);
                            var isActive = sectionItem.Id == SelectedSectionId;
                            <button type="button"
                                    class="srs-section-row @(isActive ? "active" : string.Empty)"
                                    @onclick="() => SelectSection(sectionItem.Id)">
                                <span class="srs-letter-badge">@sectionItem.Letter</span>
                                <span class="srs-section-main">
                                    <span class="srs-section-title">@sectionItem.Heading</span>
                                    <span class="srs-line-meta">Line @(sectionItem.LineStart)</span>
                                </span>
                                <span class="srs-violation-pill @status.CssClass">@status.BadgeText</span>
                            </button>
                        }
                    }
                </div>
            </aside>

            <main class="srs-focus-panel">
                @if (selectedSection is null)
                {
                    <div class="srs-empty-center">Select a section to review.</div>
                }
                else
                {
                    <div class="srs-focus-workspace">
                        <section class="srs-details-pane">
                            <section class="srs-stage-card" aria-label="Section details">
                                <div class="srs-stage-title">Section details</div>
                                <div class="srs-focus-header">
                                    <div class="srs-focus-title-row">
                                        <span class="srs-letter-badge large">@selectedSection.Letter</span>
                                        <div class="srs-focus-title">
                                            <h2>@selectedSection.Heading</h2>
                                            <div class="srs-center-meta">Line @(selectedSection.LineStart) - @(selectedSection.LineCount) lines</div>
                                        </div>
                                    </div>
                                    <div class="srs-section-nav">
                                        <button type="button" class="srs-btn srs-btn-ghost" @onclick="() => SelectAdjacentIssue(-1)" disabled="@(!HasAdjacentIssue(-1))">
                                            Previous issue
                                        </button>
                                        <button type="button" class="srs-btn srs-btn-ghost" @onclick="() => SelectAdjacentIssue(1)" disabled="@(!HasAdjacentIssue(1))">
                                            Next issue
                                        </button>
                                    </div>
                                </div>
                            </section>

                            <section class="srs-document-card">
                                <div class="srs-section-label-row">
                                    <span class="srs-panel-label">Section content</span>
                                    <span>Original markdown</span>
                                </div>
                                <div class="srs-markdown">
                                    @((MarkupString)RenderMarkdown(selectedSection.Content, SectionSearchText))
                                </div>
                            </section>
                        </section>

                        <section class="srs-checklist-pane">
                            <section class="srs-stage-card" aria-label="Checklist">
                                <div class="srs-stage-title">Check list</div>
                                <section class="srs-conclusion-card @(selectedViolations.Count == 0 ? "clean" : "needs-work")">
                                    <div>
                                        <div class="srs-conclusion-kicker">Conclusion</div>
                                        <h3>@GetSectionConclusion(selectedViolations)</h3>
                                        <p>@GetSectionAction(selectedViolations)</p>
                                    </div>
                                    <div class="srs-conclusion-stats">
                                        <span>@selectedErrorCount errors</span>
                                        <span>@selectedWarningCount warnings</span>
                                        <span>@selectedInfoCount info</span>
                                    </div>
                                </section>
                                @if (selectedViolations.Count > 0)
                                {
                                    <section class="srs-fix-list" aria-label="Fix checklist">
                                        <div class="srs-section-label-row">
                                            <span class="srs-panel-label">Fix checklist</span>
                                            <span>@selectedViolations.Count item@(selectedViolations.Count == 1 ? string.Empty : "s")</span>
                                        </div>
                                        @for (var i = 0; i < selectedViolations.Count; i++)
                                        {
                                            var violation = selectedViolations[i];
                                            var reasonKey = BuildReasonKey(selectedSection.Id, violation, i);
                                            var reasonExpanded = ExpandedReasonKeys.Contains(reasonKey);
                                            <article class="srs-fix-item @GetSeverityClass(violation.Severity)">
                                                <div class="srs-fix-heading">
                                                    <span class="srs-rule-id @GetSeverityClass(violation.Severity)">@violation.RuleId</span>
                                                    <span>@violation.Title</span>
                                                </div>
                                                <div class="srs-fix-text">@violation.Fix</div>
                                                <button type="button"
                                                        class="srs-btn srs-btn-ghost srs-reason-toggle"
                                                        @onclick="() => ToggleReason(reasonKey)">
                                                    @(reasonExpanded ? "Hide evidence" : "Show evidence")
                                                </button>
                                                @if (reasonExpanded)
                                                {
                                                    <div class="srs-reason-box">
                                                        <div class="srs-detail-label">Matched</div>
                                                        <div class="srs-matched-text">@TruncateForDisplay(violation.Matched, 120)</div>
                                                        <div class="srs-detail-label">Reason</div>
                                                        <div>@violation.Reason</div>
                                                    </div>
                                                }
                                            </article>
                                        }
                                    </section>
                                }
                            </section>
                        </section>
                    </div>
                }
            </main>
        </div>
    </div>
}

@if (ShowRevisionModal)
{
    <div class="srs-modal-overlay" @onclick="CloseRevisionPromptModal">
        <div class="srs-modal-card" @onclick:stopPropagation="true">
            <div class="srs-modal-header">
                <h3>Revision Prompt</h3>
                <button type="button" class="srs-btn srs-btn-ghost" @onclick="CloseRevisionPromptModal">Close</button>
            </div>
            <div class="srs-modal-body">
                <pre>@RevisionPromptText</pre>
            </div>
            <div class="srs-modal-footer">
                <button type="button" class="srs-btn srs-btn-primary" @onclick="CopyRevisionPromptAsync">@CopyButtonLabel</button>
                <button type="button" class="srs-btn srs-btn-ghost" @onclick="CloseRevisionPromptModal">Close</button>
            </div>
        </div>
    </div>
}

