@page "/migration-progress-tracker"
@implements IAsyncDisposable

@using DevExpress.Blazor
@using Microsoft.JSInterop
@using SmartReviewSystem.Models
@using SmartReviewSystem.Services.MigrationProgressTracker

@inject IMigrationProgressTrackerService TrackerService
@inject ILogger<MigrationProgressTracker> Logger
@inject IJSRuntime JS

<PageTitle>Migration Progress Tracker</PageTitle>

<section class="migration-tracker-page">
    <header class="migration-tracker-hero">
        <h1 class="migration-tracker-hero__title">Migration Progress Tracker</h1>

        <label class="migration-tracker-searchbar migration-tracker-hero__search">
            <span class="migration-tracker-searchbar__icon" aria-hidden="true"></span>
            <input class="migration-tracker-searchbar__input"
                   aria-label="Search migration items"
                   @bind="SearchText"
                   @bind:event="oninput"
                   placeholder="Form name, process code, step code, page name" />
            @if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <button type="button"
                        class="migration-tracker-searchbar__clear"
                        aria-label="Clear search"
                        title="Clear search"
                        @onclick="ClearSearch">
                    ×
                </button>
            }
        </label>

        <div class="migration-tracker-hero__actions">
            <button class="migration-tracker-refresh" type="button" @onclick="LoadAsync" disabled="@IsLoading">
                @(IsLoading ? "Refreshing..." : "Refresh")
            </button>
        </div>
    </header>

    @if (IsLoading)
    {
        <div class="migration-tracker-state migration-tracker-state--loading">
            <p>Loading migration progress...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="migration-tracker-state migration-tracker-state--error">
            <p>@ErrorMessage</p>
        </div>
    }
    else if (Dashboard is null)
    {
        <div class="migration-tracker-state">
            <p>No migration data is available yet.</p>
        </div>
    }
    else
    {
        <div class="migration-tracker-content">
            <nav class="migration-tracker-tabs" aria-label="Migration tracker views">
                <button type="button" class="migration-tracker-tab @(ActiveTab == ViewTab.Overview ? "is-active" : string.Empty)" @onclick="() => SetTab(ViewTab.Overview)">Overview</button>
                <button type="button" class="migration-tracker-tab @(ActiveTab == ViewTab.ByStepType ? "is-active" : string.Empty)" @onclick="() => SetTab(ViewTab.ByStepType)">By Step Type</button>
                <button type="button" class="migration-tracker-tab @(ActiveTab == ViewTab.ByProcessCode ? "is-active" : string.Empty)" @onclick="() => SetTab(ViewTab.ByProcessCode)">By Process Code</button>
                @if (IsDiagnosticsVisible)
                {
                    <button type="button" class="migration-tracker-tab @(ActiveTab == ViewTab.Diagnostics ? "is-active" : string.Empty)" @onclick="() => SetTab(ViewTab.Diagnostics)">Diagnostics</button>
                }
            </nav>

            @if (ActiveTab == ViewTab.ByStepType)
            {
                <section class="migration-tracker-switcher" aria-label="Step type selector">
                    @foreach (var stepType in StepTypeOrder)
                    {
                        <button type="button"
                                class="migration-tracker-step-toggle @(SelectedStepType == stepType ? "is-active" : string.Empty)"
                                @onclick="() => SelectStepType(stepType)">
                            @StepTypeLabel(stepType)
                        </button>
                    }
                </section>
            }

            <div class="migration-tracker-scroll">
                @if (ActiveTab == ViewTab.Overview)
                {
                    <section class="migration-tracker-kpi-strip">
                        @foreach (var kpi in Dashboard.Overview.Kpis)
                        {
                            <article class="migration-tracker-kpi-card">
                                <span>@kpi.Label</span>
                                <strong>@kpi.Value</strong>
                                <small>@kpi.SupportingText</small>
                            </article>
                        }
                    </section>

                    <section class="migration-tracker-overview-hero">
                        <div class="migration-tracker-overall">
                            <div class="migration-tracker-overall__header">
                                <div>
                                    <p class="migration-tracker-section-label">Overall migration</p>
                                    <div class="migration-tracker-overall__title-row">
                                        <h2>@Dashboard.Overview.CompletionHeadline</h2>
                                        @if (Dashboard.ExcludedProcessCodes.Count > 0)
                                        {
                                            <span class="migration-tracker-info-pill" tabindex="0" aria-label="Excluded process codes information">
                                                i
                                                <span class="migration-tracker-info-pill__tooltip" role="tooltip">
                                                    Excluded process codes: @string.Join(", ", Dashboard.ExcludedProcessCodes)
                                                </span>
                                            </span>
                                        }
                                    </div>
                                    <p class="migration-tracker-overall__supporting">
                                        Historical completion is anchored to the first DevOps move to Testing Requested.
                                    </p>
                                </div>
                                <div class="migration-tracker-overall__metric">@Dashboard.OverallCompletionPercentage.ToString("0.0")%</div>
                            </div>
                            <div class="migration-tracker-progress">
                                <div class="migration-tracker-progress__fill" style="width:@Dashboard.OverallCompletionPercentage%"></div>
                            </div>
                        </div>
                    </section>
                    <section class="migration-tracker-overview-donut-grid">
                        @if (CanRenderCharts && OverviewStepTypeCharts.Count > 0)
                        {
                            @foreach (var summary in OverviewStepTypeCharts)
                            {
                                var donutData = BuildOverviewStepTypeStatusBreakdown(summary);
                                <article class="migration-tracker-visual-card migration-tracker-visual-card--@GetStepTypeSlug(summary.StepType)">
                                    <div class="migration-tracker-visual-card__header">
                                        <div>
                                            <p class="migration-tracker-section-label">@summary.Label</p>
                                            <h3>Completed vs Pending</h3>
                                        </div>
                                    </div>
                                    @if (donutData.Count > 0)
                                    {
                                        <DxPieChart T="MigrationProgressChartDatum"
                                                    @key="@($"step-type-donut-{OverviewChartRenderVersion}-{summary.StepType}")"
                                                    Data="@donutData"
                                                    CssClass="migration-tracker-chart migration-tracker-chart--donut"
                                                    InnerDiameter="0.64"
                                                    LabelOverlap="PieChartLabelOverlap.Hide"
                                                    Palette="@GetOverviewStepTypePalette(summary.StepType, summary)">
                                            <DxPieChartSeries T="MigrationProgressChartDatum"
                                                              TArgument="string"
                                                              TValue="decimal"
                                                              ArgumentField="@((MigrationProgressChartDatum point) => point.Argument)"
                                                              ValueField="@((MigrationProgressChartDatum point) => point.Value)">
                                                <DxChartSeriesLabel Visible="false" />
                                            </DxPieChartSeries>
                                            <DxChartLegend Visible="true"
                                                           Position="RelativePosition.Outside"
                                                           HorizontalAlignment="HorizontalAlignment.Right"
                                                           VerticalAlignment="VerticalEdge.Top" />
                                            <DxChartTooltip Enabled="true"
                                                            Position="RelativePosition.Outside">
                                                <ChildContent Context="tooltip">
                                                    <div class="migration-tracker-chart-tooltip">
                                                        <span>@tooltip.Point.Argument: @tooltip.Point.Value</span>
                                                    </div>
                                                </ChildContent>
                                            </DxChartTooltip>
                                        </DxPieChart>
                                    }
                                    else
                                    {
                                        <p class="migration-tracker-empty">No step type chart data is available yet.</p>
                                    }
                                </article>
                            }
                        }
                        else
                        {
                            <article class="migration-tracker-visual-card migration-tracker-visual-card--compact">
                                <p class="migration-tracker-empty">No step type chart data is available yet.</p>
                            </article>
                        }
                    </section>

                    <section class="migration-tracker-overview-grid">
                        <article class="migration-tracker-visual-card migration-tracker-visual-card--wide" data-chart-role="completion-trend">
                            <div class="migration-tracker-visual-card__header">
                                <div>
                                    <p class="migration-tracker-section-label">Completion trend</p>
                                    <h3>Forms reaching Testing Requested over time</h3>
                                </div>
                                <div class="migration-tracker-trend-controls">
                                    <div class="migration-tracker-series-key" aria-label="Chart series">
                                        @foreach (var legendItem in CompletionTrendLegendItems)
                                        {
                                            <span class="migration-tracker-series-key__swatch" aria-hidden="true" style="background:@legendItem.Color"></span>
                                            <span>@legendItem.Label</span>
                                        }
                                    </div>
                                    <div class="migration-tracker-chart-mode-toggle" role="tablist" aria-label="Completion trend mode">
                                        @foreach (var mode in CompletionTrendModes)
                                        {
                                            <button type="button"
                                                    class="migration-tracker-chart-mode-toggle__button @(SelectedTrendChartMode == mode.Mode ? "is-active" : string.Empty)"
                                                    @onclick="() => SelectTrendChartMode(mode.Mode)">
                                                @mode.Label
                                            </button>
                                        }
                                    </div>
                                    <div class="migration-tracker-trend-switcher" role="tablist" aria-label="Completion trend granularity">
                                        @foreach (var trend in AvailableCompletionTrends)
                                        {
                                            <button type="button"
                                                    class="migration-tracker-trend-toggle @(SelectedTrendGranularity == trend.Granularity ? "is-active" : string.Empty)"
                                                    @onclick="() => SelectTrendGranularity(trend.Granularity)">
                                                @trend.Label
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (CanRenderCharts && SelectedCompletionTrend.Count > 0)
                            {
                                <DxChart T="MigrationProgressTrendPoint"
                                         @key="@($"completion-trend-{CompletionTrendChartRenderVersion}-{SelectedTrendGranularity}-{SelectedTrendChartMode}")"
                                         Data="@SelectedCompletionTrend"
                                         CssClass="migration-tracker-chart"
                                         Palette="@SelectedTrendChartPalette">
                                    <DxChartTitle Text="Completion Trend" />
                                    <DxChartLegend Visible="false" />
                                    <DxChartTooltip Enabled="true"
                                                    Position="RelativePosition.Outside">
                                        <ChildContent Context="tooltip">
                                            <div class="migration-tracker-chart-tooltip">
                                                <span>Count: @tooltip.Point.Value</span>
                                            </div>
                                        </ChildContent>
                                    </DxChartTooltip>
                                    @if (SelectedTrendChartMode == CompletionTrendChartMode.All)
                                    {
                                        <DxChartLineSeries T="MigrationProgressTrendPoint"
                                                           TArgument="string"
                                                           TValue="int"
                                                           ArgumentField="@((MigrationProgressTrendPoint point) => point.BucketLabel)"
                                                           Name="Completed"
                                                           ValueField="@((MigrationProgressTrendPoint point) => point.CompletedCount)" />
                                    }
                                    else
                                    {
                                        <DxChartLineSeries T="MigrationProgressTrendPoint"
                                                           TArgument="string"
                                                           TValue="int"
                                                           Name="Masters"
                                                           ArgumentField="@((MigrationProgressTrendPoint point) => point.BucketLabel)"
                                                           ValueField="@((MigrationProgressTrendPoint point) => point.MastersCompletedCount)" />
                                        <DxChartLineSeries T="MigrationProgressTrendPoint"
                                                           TArgument="string"
                                                           TValue="int"
                                                           Name="Documents"
                                                           ArgumentField="@((MigrationProgressTrendPoint point) => point.BucketLabel)"
                                                           ValueField="@((MigrationProgressTrendPoint point) => point.DocumentsCompletedCount)" />
                                        <DxChartLineSeries T="MigrationProgressTrendPoint"
                                                           TArgument="string"
                                                           TValue="int"
                                                           Name="Reports"
                                                           ArgumentField="@((MigrationProgressTrendPoint point) => point.BucketLabel)"
                                                           ValueField="@((MigrationProgressTrendPoint point) => point.ReportsCompletedCount)" />
                                    }
                                </DxChart>
                            }
                            else
                            {
                                <p class="migration-tracker-empty">No historical completion dates are available yet.</p>
                            }
                        </article>

                    </section>

                    <section class="migration-tracker-overview-bottom">
                        <div class="migration-tracker-overview-bottom__main">
                            <div class="migration-tracker-overview-bottom__left">
                            <div class="migration-tracker-card-grid">
                                @foreach (var summary in Dashboard.Overview.StepTypeTiles)
                                {
                                    <button type="button" class="migration-tracker-card migration-tracker-card--@GetStepTypeSlug(summary.StepType)" @onclick="() => FocusStepType(summary.StepType)">
                                        <div class="migration-tracker-card__header">
                                            <h3>@summary.Label</h3>
                                            <span class="migration-tracker-chip">@summary.StepType</span>
                                        </div>
                                        <div class="migration-tracker-card__metrics">
                                            <div><span>Total</span><strong>@summary.Total</strong></div>
                                            <div><span>Completed</span><strong>@summary.Completed</strong></div>
                                            <div><span>Pending</span><strong>@summary.Pending</strong></div>
                                            <div><span>Progress</span><strong>@summary.CompletionPercentage.ToString("0.0")%</strong></div>
                                        </div>
                                        <div class="migration-tracker-progress migration-tracker-progress--card">
                                            <div class="migration-tracker-progress__fill" style="width:@summary.CompletionPercentage%"></div>
                                        </div>
                                        <small class="migration-tracker-card__badge">@summary.Badge</small>
                                    </button>
                                }
                            </div>

                            <aside class="migration-tracker-insights-panel migration-tracker-insights-panel--horizontal">
                                <div class="migration-tracker-visual-card__header">
                                    <div>
                                        <p class="migration-tracker-section-label">Insights</p>
                                        <h3>Quick reads for migration leads</h3>
                                    </div>
                                </div>
                                <div class="migration-tracker-insights-list">
                                    @foreach (var insight in Dashboard.Overview.Insights)
                                    {
                                        <article class="migration-tracker-insight migration-tracker-insight--@insight.Tone">
                                            <span>@insight.Label</span>
                                            <strong>@insight.Value</strong>
                                            <small>@insight.SupportingText</small>
                                        </article>
                                    }
                                </div>
                            </aside>
                            </div>

                            <article class="migration-tracker-visual-card migration-tracker-visual-card--compact">
                                <div class="migration-tracker-visual-card__header">
                                    <div>
                                        <p class="migration-tracker-section-label">Backlog ranking</p>
                                        <h3>Top pending process codes</h3>
                                    </div>
                                </div>
                                @if (CanRenderCharts && PendingProcessRanking.Count > 0)
                                {
                                    <DxChart T="MigrationProgressChartDatum"
                                             @key="@($"pending-process-chart-{OverviewChartRenderVersion}")"
                                             Data="@PendingProcessRanking"
                                             CssClass="migration-tracker-chart"
                                             Palette="@BacklogChartPalette">
                                        <DxChartTitle Text="Top Pending Process Codes" />
                                        <DxChartBarSeries T="MigrationProgressChartDatum"
                                                          TArgument="string"
                                                          TValue="decimal"
                                                          Name="Pending"
                                                          ArgumentField="@((MigrationProgressChartDatum point) => point.Argument)"
                                                          ValueField="@((MigrationProgressChartDatum point) => point.Value)" />
                                    </DxChart>
                                }
                                else
                                {
                                    <p class="migration-tracker-empty">No pending process codes right now.</p>
                                }
                            </article>
                        </div>
                    </section>
                }
                else if (ActiveTab == ViewTab.ByStepType)
                {
                    @foreach (var summary in StepTypeSummariesForSelected.OrderBy(summary => StepTypeSortKey(summary.StepType)))
                    {
                        <section class="migration-tracker-group migration-tracker-group--@GetStepTypeSlug(summary.StepType)">
                            <header class="migration-tracker-group__header">
                                <div>
                                    <p class="migration-tracker-section-label">@StepTypeLabel(summary.StepType)</p>
                                    <div class="migration-tracker-group__summary-line">
                                        <h2>@summary.Total total</h2>
                                        <p class="migration-tracker-group__submetric">@summary.Completed completed</p>
                                    </div>
                                </div>
                                <div class="migration-tracker-group__metric">@summary.CompletionPercentage.ToString("0.0")%</div>
                            </header>
                            <div class="migration-tracker-progress">
                                <div class="migration-tracker-progress__fill" style="width:@summary.CompletionPercentage%"></div>
                            </div>

                            @foreach (var process in summary.ProcessGroups)
                            {
                                var expanded = ExpandedStepTypeProcesses.Contains(GetStepTypeKey(summary.StepType, process.Key));
                                var visibleItems = GetFilteredItems(process.Items);
                                if (visibleItems.Count == 0)
                                {
                                    continue;
                                }

                                <article class="migration-tracker-accordion migration-tracker-accordion--@GetStepTypeSlug(summary.StepType)">
                                    <button type="button"
                                            class="migration-tracker-accordion__toggle @(expanded ? "is-expanded" : string.Empty)"
                                            aria-expanded="@expanded"
                                            @onclick="() => ToggleStepTypeProcess(summary.StepType, process.Key)">
                                        <div class="migration-tracker-accordion__title">
                                            <h3>@process.Label</h3>
                                            <span>@process.Total total</span>
                                        </div>
                                        <div class="migration-tracker-accordion__meta">
                                            <strong>@process.CompletionPercentage.ToString("0.0")%</strong>
                                            <span>@process.Completed completed</span>
                                            <span>@process.Pending pending</span>
                                        </div>
                                        <div class="migration-tracker-accordion__action">
                                            <span class="migration-tracker-accordion__hint">@(expanded ? "Hide details" : "View details")</span>
                                            <span class="migration-tracker-accordion__chevron" aria-hidden="true"></span>
                                        </div>
                                    </button>
                                    <div class="migration-tracker-progress migration-tracker-progress--compact">
                                        <div class="migration-tracker-progress__fill" style="width:@process.CompletionPercentage%"></div>
                                    </div>
                                    @if (expanded)
                                    {
                                        <div class="migration-tracker-accordion__detail migration-tracker-accordion__detail--@GetStepTypeSlug(summary.StepType)">
                                            <div class="migration-tracker-table">
                                            <div class="migration-tracker-table__head">
                                                <span>Step Code</span>
                                                <span>Step Name</span>
                                                <span>Page Name</span>
                                                <span>Status</span>
                                                <span>Story</span>
                                            </div>
                                            @foreach (var item in visibleItems.OrderBy(i => i.StepCode))
                                            {
                                                <div class="migration-tracker-table__row">
                                                    <span class="migration-tracker-table__cell migration-tracker-table__cell--code" data-label="Step Code">@item.StepCode</span>
                                                    <span class="migration-tracker-table__cell" data-label="Step Name">@item.StepName</span>
                                                    <span class="migration-tracker-table__cell" data-label="Page Name">@item.PageName</span>
                                                    <span class="migration-tracker-table__cell" data-label="Status">
                                                        <span class="migration-tracker-status migration-tracker-status--@item.Status.ToLowerInvariant()">@item.Status</span>
                                                    </span>
                                                    <span class="migration-tracker-table__cell" data-label="Story">
                                                        @if (!string.IsNullOrWhiteSpace(item.MatchedStoryTitle))
                                                        {
                                                            <a href="@item.MatchedStoryUrl" target="_blank" rel="noopener noreferrer">@item.MatchedStoryTitle</a>
                                                        }
                                                        else
                                                        {
                                                            <span>-</span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                            </div>
                                        </div>
                                    }
                                </article>
                            }
                        </section>
                    }
                }
                else if (ActiveTab == ViewTab.ByProcessCode)
                {
                    <section class="migration-tracker-process-grid">
                        @foreach (var process in ProcessSummariesOrdered)
                        {
                            var processVisible = GetFilteredItems(process.StepTypeSummaries.SelectMany(s => s.ProcessGroups).SelectMany(g => g.Items).ToList());
                            var activeStepType = GetActiveProcessStepType(process.ProcessCode);
                            var activeStepSummary = process.StepTypeSummaries
                                .FirstOrDefault(summary => string.Equals(summary.StepType, activeStepType, StringComparison.OrdinalIgnoreCase));
                            var activeStepItems = activeStepSummary is null
                                ? []
                                : GetFilteredItems(activeStepSummary.ProcessGroups.SelectMany(g => g.Items).ToList());
                            if (processVisible.Count == 0)
                            {
                                continue;
                            }

                            <article class="migration-tracker-process-card">
                                <button type="button" class="migration-tracker-process-card__toggle" @onclick="() => ToggleProcess(process.ProcessCode)">
                                    <div>
                                        <p class="migration-tracker-section-label">Process code</p>
                                        <h2>@process.ProcessCode</h2>
                                    </div>
                                    <div class="migration-tracker-process-card__metric">
                                        <strong>@process.CompletionPercentage.ToString("0.0")%</strong>
                                        <span>@process.Completed completed / @process.Total total</span>
                                    </div>
                                </button>

                                <div class="migration-tracker-process-card__summary">
                                    @foreach (var stepSummary in process.StepTypeSummaries.OrderBy(summary => StepTypeSortKey(summary.StepType)))
                                    {
                                        var stepTypeKey = GetProcessStepTypeKey(process.ProcessCode, stepSummary.StepType);
                                        var expandedStepType = ExpandedProcessStepTypes.Contains(stepTypeKey);
                                        <div class="migration-tracker-process-card__summary-panel">
                                            <button type="button"
                                                    class="migration-tracker-process-card__summary-item migration-tracker-process-card__summary-item--@GetStepTypeSlug(stepSummary.StepType) @(expandedStepType ? "is-expanded" : string.Empty)"
                                                    aria-expanded="@expandedStepType"
                                                    @onclick="() => ToggleProcessStepType(process.ProcessCode, stepSummary.StepType)">
                                                <span>@StepTypeLabel(stepSummary.StepType)</span>
                                                <strong>@stepSummary.CompletionPercentage.ToString("0.0")%</strong>
                                                <small>@stepSummary.Completed/@stepSummary.Total</small>
                                                <span class="migration-tracker-process-card__summary-chevron" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                    }
                                </div>

                                @if (activeStepSummary is not null && activeStepItems.Count > 0)
                                {
                                    <div class="migration-tracker-process-card__detail migration-tracker-process-card__detail--@GetStepTypeSlug(activeStepSummary.StepType)">
                                        <div class="migration-tracker-table">
                                            <div class="migration-tracker-table__head">
                                                <span>Step Code</span>
                                                <span>Step Name</span>
                                                <span>Page Name</span>
                                                <span>Status</span>
                                                <span>Story</span>
                                            </div>
                                            @foreach (var item in activeStepItems.OrderBy(i => i.StepCode))
                                            {
                                                <div class="migration-tracker-table__row">
                                                    <span class="migration-tracker-table__cell migration-tracker-table__cell--code" data-label="Step Code">@item.StepCode</span>
                                                    <span class="migration-tracker-table__cell" data-label="Step Name">@item.StepName</span>
                                                    <span class="migration-tracker-table__cell" data-label="Page Name">@item.PageName</span>
                                                    <span class="migration-tracker-table__cell" data-label="Status">
                                                        <span class="migration-tracker-status migration-tracker-status--@item.Status.ToLowerInvariant()">@item.Status</span>
                                                    </span>
                                                    <span class="migration-tracker-table__cell" data-label="Story">
                                                        @if (!string.IsNullOrWhiteSpace(item.MatchedStoryTitle))
                                                        {
                                                            <a href="@item.MatchedStoryUrl" target="_blank" rel="noopener noreferrer">@item.MatchedStoryTitle</a>
                                                        }
                                                        else
                                                        {
                                                            <span>-</span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="migration-tracker-progress migration-tracker-progress--compact">
                                    <div class="migration-tracker-progress__fill" style="width:@process.CompletionPercentage%"></div>
                                </div>
                            </article>
                        }
                    </section>
                }
                else if (IsDiagnosticsVisible)
                {
                    <section class="migration-tracker-overview-grid">
                        <article class="migration-tracker-visual-card migration-tracker-visual-card--wide">
                            <div class="migration-tracker-visual-card__header">
                                <div>
                                    <p class="migration-tracker-section-label">Cross-check diagnostics</p>
                                    <h3>Forms not counted by the progress tracker</h3>
                                </div>
                            </div>
                            <div class="migration-tracker-diagnostics-filters">
                                <label class="migration-tracker-searchbar migration-tracker-diagnostics-filters__search">
                                    <span class="migration-tracker-searchbar__icon" aria-hidden="true"></span>
                                    <input class="migration-tracker-searchbar__input"
                                           aria-label="Search diagnostics"
                                           @bind="DiagnosticsSearchText"
                                           @bind:event="oninput"
                                           placeholder="Search form, process, story, page" />
                                    @if (!string.IsNullOrWhiteSpace(DiagnosticsSearchText))
                                    {
                                        <button type="button"
                                                class="migration-tracker-searchbar__clear"
                                                aria-label="Clear diagnostics search"
                                                title="Clear diagnostics search"
                                                @onclick="ClearDiagnosticsSearch">
                                            Ã—
                                        </button>
                                    }
                                </label>
                                <label class="migration-tracker-diagnostics-filter">
                                    <span>Reason</span>
                                    <select @bind="SelectedDiagnosticsReason">
                                        @foreach (var option in DiagnosticsReasonOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </label>
                                <label class="migration-tracker-diagnostics-filter">
                                    <span>Step Type</span>
                                    <select @bind="SelectedDiagnosticsStepType">
                                        @foreach (var option in DiagnosticsStepTypeOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </label>
                                <label class="migration-tracker-diagnostics-filter">
                                    <span>Phase Updated</span>
                                    <select @bind="SelectedDiagnosticsPhaseUpdated">
                                        @foreach (var option in DiagnosticsPhaseUpdatedOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </label>
                            </div>
                            @if (FilteredExclusionDiagnostics.Count > 0)
                            {
                                <p class="migration-tracker-diagnostics-summary">
                                    @FilteredExclusionDiagnostics.Count item(s) match the current diagnostics filters.
                                </p>
                                <div class="migration-tracker-diagnostics-table">
                                    <div class="migration-tracker-diagnostics-table__head">
                                        <span>Step</span>
                                        <span>Form</span>
                                        <span>Page</span>
                                        <span>Story</span>
                                        <span>Phase Updated</span>
                                        <span>Reason</span>
                                        <span>Match Detail</span>
                                    </div>
                                    @foreach (var diagnostic in FilteredExclusionDiagnostics)
                                    {
                                        <div class="migration-tracker-diagnostics-table__row">
                                            <span class="migration-tracker-diagnostics-table__cell" data-label="Step">
                                                @diagnostic.StepType / @diagnostic.ProcessCode / @diagnostic.StepCode
                                                @if (!string.IsNullOrWhiteSpace(diagnostic.MicroFrontendName) || !string.IsNullOrWhiteSpace(diagnostic.FormName))
                                                {
                                                    <small class="migration-tracker-diagnostics-table__meta">
                                                        @($"{diagnostic.MicroFrontendName ?? "No MFE"} / {diagnostic.FormName ?? "No Form"}")
                                                    </small>
                                                }
                                            </span>
                                            <span class="migration-tracker-diagnostics-table__cell" data-label="Form">@diagnostic.StepName</span>
                                            <span class="migration-tracker-diagnostics-table__cell" data-label="Page">@(string.IsNullOrWhiteSpace(diagnostic.PageName) ? "-" : diagnostic.PageName)</span>
                                            <span class="migration-tracker-diagnostics-table__cell" data-label="Story">
                                                @if (!string.IsNullOrWhiteSpace(diagnostic.MatchedStoryTitle))
                                                {
                                                    <a href="@diagnostic.MatchedStoryUrl" target="_blank" rel="noopener noreferrer">
                                                        @diagnostic.MatchedStoryTitle
                                                    </a>
                                                    @if (diagnostic.StoryId is not null)
                                                    {
                                                        <small class="migration-tracker-diagnostics-table__meta">ID: @diagnostic.StoryId</small>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(diagnostic.StoryState))
                                                    {
                                                        <small class="migration-tracker-diagnostics-table__meta">State: @diagnostic.StoryState</small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </span>
                                            <span class="migration-tracker-diagnostics-table__cell" data-label="Phase Updated">
                                                @(diagnostic.OrchestratorPhaseUpdated?.ToString("dd MMM yyyy HH:mm") ?? "-")
                                            </span>
                                            <span class="migration-tracker-diagnostics-table__cell" data-label="Reason">
                                                <span class="migration-tracker-diagnostics-reason">@diagnostic.Reason</span>
                                            </span>
                                            <span class="migration-tracker-diagnostics-table__cell" data-label="Match Detail">
                                                @(string.IsNullOrWhiteSpace(diagnostic.MatchDetail) ? "-" : diagnostic.MatchDetail)
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                            else if (Dashboard.ExclusionDiagnostics.Count > 0)
                            {
                                <p class="migration-tracker-empty">No diagnostics match the current filters.</p>
                            }
                            else
                            {
                                <p class="migration-tracker-empty">All matched forms are currently being counted by the tracker.</p>
                            }
                        </article>
                    </section>
                }
            </div>
        </div>
    }
</section>

@code {
    private enum ViewTab
    {
        Overview,
        ByStepType,
        ByProcessCode,
        Diagnostics
    }

    private enum CompletionTrendChartMode
    {
        All,
        ByStepType
    }

    private static readonly string[] StepTypeOrder = ["M", "D", "R"];

    private MigrationProgressTrackerViewModel? Dashboard;
    private ViewTab ActiveTab = ViewTab.Overview;
    private string SelectedStepType = "D";
    private CompletionTrendChartMode SelectedTrendChartMode = CompletionTrendChartMode.All;
    private MigrationProgressTrendGranularity SelectedTrendGranularity = MigrationProgressTrendGranularity.Weekly;
    private string SearchText = string.Empty;
    private string DiagnosticsSearchText = string.Empty;
    private string SelectedDiagnosticsReason = "All Reasons";
    private string SelectedDiagnosticsStepType = "All Step Types";
    private string SelectedDiagnosticsPhaseUpdated = "All";
    private bool IsDiagnosticsVisible;
    private readonly HashSet<string> ExpandedProcesses = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> ExpandedStepTypeProcesses = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> ExpandedProcessStepTypes = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource _loadCts = new();
    private IJSObjectReference? _shortcutModule;
    private IJSObjectReference? _shortcutRegistration;
    private DotNetObjectReference<MigrationProgressTracker>? _selfReference;
    private bool _chartsActivated;
    private bool _isDisposed;
    private int OverviewChartRenderVersion;
    private int CompletionTrendChartRenderVersion;
    private bool IsLoading = true;
    private string ErrorMessage = string.Empty;

    private string StatusLabel => string.IsNullOrWhiteSpace(ErrorMessage)
        ? (Dashboard is null ? "Idle" : "Loaded")
        : "Failed";

    private IEnumerable<MigrationProgressProcessSummary> ProcessSummariesOrdered =>
        Dashboard?.ProcessSummaries ?? [];

    private IReadOnlyList<MigrationProgressOverviewStepTypeTile> OverviewStepTypeCharts =>
        (Dashboard?.Overview.StepTypeTiles ?? [])
            .OrderBy(summary => StepTypeSortKey(summary.StepType))
            .ToList();

    private IReadOnlyList<MigrationProgressTrendSeries> AvailableCompletionTrends =>
        Dashboard?.Overview.CompletionTrends ?? [];

    private IReadOnlyList<MigrationProgressChartDatum> PendingProcessRanking =>
        Dashboard?.Overview.PendingProcessRanking ?? [];

    private IReadOnlyList<MigrationProgressExclusionDiagnostic> ExclusionDiagnostics =>
        Dashboard?.ExclusionDiagnostics ?? [];

    private IReadOnlyList<string> DiagnosticsReasonOptions =>
        ["All Reasons", .. ExclusionDiagnostics.Select(d => d.Reason).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(reason => reason)];

    private IReadOnlyList<string> DiagnosticsStepTypeOptions =>
        ["All Step Types", .. ExclusionDiagnostics.Select(d => StepTypeLabel(d.StepType)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(label => label)];

    private static IReadOnlyList<string> DiagnosticsPhaseUpdatedOptions =>
        ["All", "Has Phase Updated", "Missing Phase Updated"];

    private List<MigrationProgressExclusionDiagnostic> FilteredExclusionDiagnostics =>
        ExclusionDiagnostics.Where(MatchesDiagnosticsFilters).ToList();

    private List<MigrationProgressTrendPoint> SelectedCompletionTrend =>
        AvailableCompletionTrends
            .FirstOrDefault(trend => trend.Granularity == SelectedTrendGranularity)
            ?.Points
        ?? [];

    private static IReadOnlyList<CompletionTrendModeOption> CompletionTrendModes =>
        [
            new(CompletionTrendChartMode.All, "All"),
            new(CompletionTrendChartMode.ByStepType, "By Step Type")
        ];

    private IReadOnlyList<CompletionTrendLegendItem> CompletionTrendLegendItems =>
        SelectedTrendChartMode == CompletionTrendChartMode.All
            ? [new("Completed", TrendChartPalette[0])]
            : [
                new("Masters", MastersOverviewPalette[0]),
                new("Documents", DocumentsOverviewPalette[0]),
                new("Reports", ReportsOverviewPalette[0])
            ];

    private bool CanRenderCharts =>
        !_isDisposed &&
        !IsLoading &&
        Dashboard is not null &&
        _chartsActivated;

    private static readonly string[] TrendChartPalette = ["#7E5AA6", "#D7C7E8"];
    private static readonly string[] MastersOverviewPalette = ["#6D4C92", "#D8C8EA"];
    private static readonly string[] ReportsOverviewPalette = ["#B07A49", "#F0DDC7"];
    private static readonly string[] DocumentsOverviewPalette = ["#5C84B4", "#D9E8F7"];
    private static readonly string[] BacklogChartPalette = ["#8661B2", "#D9C9EA"];

    private string[] SelectedTrendChartPalette =>
        SelectedTrendChartMode == CompletionTrendChartMode.All
            ? [TrendChartPalette[0]]
            : [MastersOverviewPalette[0], DocumentsOverviewPalette[0], ReportsOverviewPalette[0]];

    private int FilteredItemCount =>
        Dashboard is null ? 0 : GetAllItems().Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _shortcutModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard-shortcuts.js");
            _selfReference = DotNetObjectReference.Create(this);
            _shortcutRegistration = await _shortcutModule.InvokeAsync<IJSObjectReference>("registerDiagnosticsShortcut", _selfReference);
        }

        if (_chartsActivated || _isDisposed || IsLoading || Dashboard is null)
        {
            return;
        }

        _chartsActivated = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        var previousLoadCts = _loadCts;
        _loadCts = new CancellationTokenSource();
        previousLoadCts.Cancel();
        previousLoadCts.Dispose();

        var cancellationToken = _loadCts.Token;
        IsLoading = true;
        ErrorMessage = string.Empty;
        _chartsActivated = false;

        try
        {
            var dashboard = await TrackerService.GetDashboardAsync(cancellationToken);
            if (cancellationToken.IsCancellationRequested || _isDisposed)
            {
                return;
            }

            Dashboard = NormalizeDashboard(dashboard);
            SelectedStepType = Dashboard.StepTypeSummaries.FirstOrDefault()?.StepType ?? "D";
            SelectedTrendGranularity = Dashboard.Overview.DefaultTrendGranularity;
            OverviewChartRenderVersion++;
            CompletionTrendChartRenderVersion++;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested || _isDisposed)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load migration progress tracker.");
            ErrorMessage = $"Failed to load migration progress tracker: {ex.Message}";
            Dashboard = null;
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested && !_isDisposed)
            {
                IsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void SetTab(ViewTab tab)
    {
        if (tab == ViewTab.Diagnostics && !IsDiagnosticsVisible)
        {
            ActiveTab = ViewTab.Overview;
            return;
        }

        ActiveTab = tab;
    }

    private void SelectTrendGranularity(MigrationProgressTrendGranularity granularity)
    {
        SelectedTrendGranularity = granularity;
        CompletionTrendChartRenderVersion++;
    }

    private void SelectTrendChartMode(CompletionTrendChartMode mode)
    {
        SelectedTrendChartMode = mode;
        CompletionTrendChartRenderVersion++;
    }

    private void ClearSearch() => SearchText = string.Empty;

    private void ClearDiagnosticsSearch() => DiagnosticsSearchText = string.Empty;

    private void FocusStepType(string stepType)
    {
        SelectedStepType = stepType;
        ActiveTab = ViewTab.ByStepType;
    }

    private void SelectStepType(string stepType) => SelectedStepType = stepType;

    private static int StepTypeSortKey(string stepType) => stepType.ToUpperInvariant() switch
    {
        "M" => 0,
        "D" => 1,
        "R" => 2,
        _ => 3
    };

    private static string GetStepTypeSlug(string stepType) => stepType.ToUpperInvariant() switch
    {
        "M" => "masters",
        "D" => "documents",
        "R" => "reports",
        _ => "other"
    };

    private void ToggleProcess(string processCode)
    {
        if (!ExpandedProcesses.Add(processCode))
        {
            ExpandedProcesses.Remove(processCode);
        }
    }

    private void ToggleStepTypeProcess(string stepType, string processCode)
    {
        var key = GetStepTypeKey(stepType, processCode);
        if (!ExpandedStepTypeProcesses.Add(key))
        {
            ExpandedStepTypeProcesses.Remove(key);
        }
    }

    private void ToggleProcessStepType(string processCode, string stepType)
    {
        var key = GetProcessStepTypeKey(processCode, stepType);
        if (ExpandedProcessStepTypes.Contains(key))
        {
            ExpandedProcessStepTypes.Remove(key);
            return;
        }

        var prefix = $"{processCode}::";
        var toRemove = ExpandedProcessStepTypes
            .Where(existing => existing.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            .ToList();

        foreach (var existing in toRemove)
        {
            ExpandedProcessStepTypes.Remove(existing);
        }

        ExpandedProcessStepTypes.Add(key);
    }

    private string? GetActiveProcessStepType(string processCode)
    {
        var prefix = $"{processCode}::";
        var key = ExpandedProcessStepTypes.FirstOrDefault(existing => existing.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
        return key is null ? null : key[prefix.Length..];
    }

    private string StepTypeLabel(string stepType) => stepType.ToUpperInvariant() switch
    {
        "D" => "Documents",
        "R" => "Reports",
        "M" => "Masters",
        _ => stepType
    };

    private static string GetStepTypeKey(string stepType, string processCode) => $"{stepType}::{processCode}";

    private static string GetProcessStepTypeKey(string processCode, string stepType) => $"{processCode}::{stepType}";

    private IEnumerable<MigrationProgressStepTypeSummary> StepTypeSummariesForSelected =>
        Dashboard?.StepTypeSummaries
            .Where(s => string.Equals(s.StepType, SelectedStepType, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.StepType)
            ?? Enumerable.Empty<MigrationProgressStepTypeSummary>();

    private List<MigrationProgressItem> GetAllItems() =>
        Dashboard?.ProcessSummaries
            .SelectMany(p => p.StepTypeSummaries)
            .SelectMany(s => s.ProcessGroups)
            .SelectMany(g => g.Items)
            .Where(MatchesSearch)
            .ToList()
        ?? [];

    private List<MigrationProgressItem> GetFilteredItems(IEnumerable<MigrationProgressItem> items) =>
        items.Where(MatchesSearch).ToList();

    private bool MatchesSearch(MigrationProgressItem item)
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            return true;
        }

        var term = SearchText.Trim();
        return Contains(item.ProcessCode, term)
            || Contains(item.StepCode, term)
            || Contains(item.StepName, term)
            || Contains(item.PageName, term)
            || Contains(item.MatchedStoryTitle, term)
            || Contains(item.MatchedStoryUrl, term);
    }

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private bool MatchesDiagnosticsFilters(MigrationProgressExclusionDiagnostic diagnostic)
    {
        if (!string.Equals(SelectedDiagnosticsReason, "All Reasons", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(diagnostic.Reason, SelectedDiagnosticsReason, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.Equals(SelectedDiagnosticsStepType, "All Step Types", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(StepTypeLabel(diagnostic.StepType), SelectedDiagnosticsStepType, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.Equals(SelectedDiagnosticsPhaseUpdated, "Has Phase Updated", StringComparison.OrdinalIgnoreCase) &&
            diagnostic.OrchestratorPhaseUpdated is null)
        {
            return false;
        }

        if (string.Equals(SelectedDiagnosticsPhaseUpdated, "Missing Phase Updated", StringComparison.OrdinalIgnoreCase) &&
            diagnostic.OrchestratorPhaseUpdated is not null)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(DiagnosticsSearchText))
        {
            return true;
        }

        var term = DiagnosticsSearchText.Trim();
        return Contains(diagnostic.StepType, term)
            || (diagnostic.StoryId?.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || Contains(diagnostic.ProcessCode, term)
            || Contains(diagnostic.StepCode, term)
            || Contains(diagnostic.StepName, term)
            || Contains(diagnostic.PageName, term)
            || Contains(diagnostic.MatchedStoryTitle, term)
            || Contains(diagnostic.StoryState, term)
            || Contains(diagnostic.Reason, term);
    }

    private static List<MigrationProgressChartDatum> BuildOverviewStepTypeStatusBreakdown(MigrationProgressOverviewStepTypeTile summary) =>
        [
            ..BuildStatusBreakdownPoint("Completed", summary.Completed),
            ..BuildStatusBreakdownPoint("Pending", summary.Pending)
        ];

    private static IEnumerable<MigrationProgressChartDatum> BuildStatusBreakdownPoint(string argument, int value)
    {
        if (value <= 0)
        {
            yield break;
        }

        yield return new MigrationProgressChartDatum(argument, "Status", value);
    }

    private static MigrationProgressTrackerViewModel NormalizeDashboard(MigrationProgressTrackerViewModel dashboard)
    {
        var overview = dashboard.Overview with
        {
            Kpis = dashboard.Overview.Kpis ?? [],
            CompletedStepTypeBreakdown = dashboard.Overview.CompletedStepTypeBreakdown ?? [],
            PendingStepTypeBreakdown = dashboard.Overview.PendingStepTypeBreakdown ?? [],
            PendingProcessRanking = dashboard.Overview.PendingProcessRanking ?? [],
            CompletionTrends = dashboard.Overview.CompletionTrends ?? [],
            StepTypeTiles = dashboard.Overview.StepTypeTiles ?? [],
            Insights = dashboard.Overview.Insights ?? []
        };

        return dashboard with
        {
            ExcludedProcessCodes = dashboard.ExcludedProcessCodes ?? [],
            Overview = overview,
            ExclusionDiagnostics = dashboard.ExclusionDiagnostics ?? [],
            StepTypeSummaries = dashboard.StepTypeSummaries ?? [],
            ProcessSummaries = dashboard.ProcessSummaries ?? []
        };
    }

    private static string[] GetOverviewStepTypePalette(string stepType, MigrationProgressOverviewStepTypeTile summary)
    {
        var completedColor = GetCompletedDonutColor(stepType);
        var pendingColor = GetPendingDonutColor(stepType);

        if (summary.Completed <= 0 && summary.Pending > 0)
        {
            return [pendingColor, completedColor];
        }

        return [completedColor, pendingColor];
    }

    private static string GetCompletedDonutColor(string stepType) => stepType.ToUpperInvariant() switch
    {
        "M" => MastersOverviewPalette[0],
        "R" => ReportsOverviewPalette[0],
        "D" => DocumentsOverviewPalette[0],
        _ => TrendChartPalette[0]
    };

    private static string GetPendingDonutColor(string stepType) => stepType.ToUpperInvariant() switch
    {
        "M" => MastersOverviewPalette[1],
        "R" => ReportsOverviewPalette[1],
        "D" => DocumentsOverviewPalette[1],
        _ => TrendChartPalette[1]
    };

    private sealed record CompletionTrendModeOption(CompletionTrendChartMode Mode, string Label);

    private sealed record CompletionTrendLegendItem(string Label, string Color);

    [JSInvokable]
    public Task HandleDiagnosticsShortcut()
    {
        IsDiagnosticsVisible = true;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _loadCts.Cancel();
        _loadCts.Dispose();

        if (_shortcutRegistration is not null)
        {
            try
            {
                await _shortcutRegistration.InvokeVoidAsync("dispose");
                await _shortcutRegistration.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_shortcutModule is not null)
        {
            try
            {
                await _shortcutModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}

